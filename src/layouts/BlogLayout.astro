---
import type { CollectionEntry } from 'astro:content';
import { useTranslations } from '../i18n/ui';
import '../styles/fonts.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import { COPYRIGHT_YEAR, SITE_URL, publicPath } from '../consts';
import ogFallback from '../assets/team.jpg';

interface Props {
  post?: CollectionEntry<'blog'>;
  lang: 'en' | 'fr';
  title?: string;
  description?: string;
  translatedSlug?: string;
}

const { post, lang, title, description, translatedSlug } = Astro.props;
const t = useTranslations(lang);

const pageTitle = title ?? post?.data.title ?? t.blogTitle;
const pageDesc = description ?? post?.data.description ?? t.blogDescription;

const otherLang = lang === 'en' ? 'fr' : 'en';
const legalPrefix = lang === 'fr' ? '/fr' : '';
const otherLangLabel = lang === 'en' ? 'FR' : 'EN';

// Translated URL: if a translated slug is provided, use it; otherwise fall back to the other language's blog listing
const translatedUrl = translatedSlug ? `/${otherLang}/blog/${translatedSlug}` : `/${otherLang}/blog`;
const selfUrl = publicPath(Astro.url.pathname);
const enUrl = lang === 'en' ? selfUrl : translatedUrl;
const frUrl = lang === 'fr' ? selfUrl : translatedUrl;

const site = Astro.site ?? new URL(SITE_URL);
const abs = (p: string) => new URL(publicPath(p), site).href;
const canonical = abs(selfUrl);
// A post with no translation only has a listing on the other side, which is
// not the same page — hreflang pairs only real equivalents.
const hasTwin = !post || !!translatedSlug;
const og = await getImage({ src: post?.data.featuredImage ?? ogFallback, width: 1200, format: 'jpg', quality: 80 });
// This layout is standalone — it never wraps Layout.astro — so the two
// persistent conversion bands have to be mounted here as well. Blog routes
// are already per-locale, so they render in one language via `static`.
import StatusStrip from '../components/StatusStrip.astro';
import StickyCta from '../components/StickyCta.astro';
import { Image } from 'astro:assets';
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!-- Tints the mobile browser chrome to match the status strip — keep in
       step with --color-olive in global.css. -->
  <meta name="theme-color" content="#463f31">
  <meta name="color-scheme" content="light">
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="canonical" href={canonical}>
  {hasTwin && (
    <>
      <link rel="alternate" hreflang="en" href={abs(enUrl)}>
      <link rel="alternate" hreflang="fr" href={abs(frUrl)}>
      <link rel="alternate" hreflang="x-default" href={abs(enUrl)}>
    </>
  )}
  <meta property="og:type" content={post ? 'article' : 'website'}>
  <meta property="og:site_name" content="Team Canada ICC">
  <meta property="og:locale" content={lang === 'fr' ? 'fr_CA' : 'en_CA'}>
  <meta property="og:url" content={canonical}>
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={pageDesc}>
  <meta property="og:image" content={new URL(og.src, site).href}>
  <meta name="twitter:card" content="summary_large_image">
</head>
<body class="bg-cream text-body font-sans antialiased">
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[200] focus:bg-gold focus:text-ink focus:px-4 focus:py-2 focus:font-semibold">{t.skipToContent}</a>

  <StatusStrip static={lang} href={lang === 'fr' ? '/fr/sponsor' : '/sponsor'} />

  <!-- Blog Header Nav — sticks below the status strip, not under it -->
  <nav class="bg-white/80 backdrop-blur-sm border-b border-border-light sticky z-40" style="top: var(--status-strip-h)">
    <div class="max-w-5xl mx-auto px-4 md:px-6">
      <div class="flex items-center justify-between h-14 md:h-16">
        <a href={lang === 'fr' ? '/fr' : '/'} class="flex items-center gap-2 group">
          <div class="w-7 h-7 rounded-full border-2 border-gold flex items-center justify-center group-hover:bg-gold/10 transition-colors">
            <span class="text-gold text-xs font-bold">TC</span>
          </div>
          <span class="text-ink font-bold text-sm hidden sm:inline">TEAM CANADA</span>
        </a>
        <div class="flex items-center gap-4">
          <a href={`/${lang}/blog`} class="text-sm text-muted hover:text-gold transition-colors font-medium">
            {t.blog}
          </a>
          <div class="flex items-center gap-1">
            <a href={enUrl} data-set-lang="en" hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined} class={`text-xs px-2 py-0.5 border border-gold font-semibold btn-cta transition-colors ${lang === 'en' ? 'bg-gold text-ink' : 'text-gold hover:bg-gold hover:text-ink'}`}>EN</a>
            <a href={frUrl} data-set-lang="fr" hreflang="fr" lang="fr" aria-current={lang === 'fr' ? 'true' : undefined} class={`text-xs px-2 py-0.5 border border-gold font-semibold btn-cta transition-colors ${lang === 'fr' ? 'bg-gold text-ink' : 'text-gold hover:bg-gold hover:text-ink'}`}>FR</a>
          </div>
        </div>
      </div>
    </div>
  </nav>

  <main id="main" tabindex="-1" class="min-h-screen focus:outline-none">
    {
      post ? (
        /* Single Post Layout */
        <article class="max-w-3xl mx-auto px-4 md:px-6 py-8 md:py-12">
          <header class="mb-8 md:mb-10">
            <a href={`/${lang}/blog`} class="inline-flex items-center gap-1.5 text-sm text-muted hover:text-gold transition-colors mb-6 font-medium">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
              {t.backToBlog}
            </a>

            {
              post.data.featuredImage && (
                <Image
                  src={post.data.featuredImage}
                  alt=""
                  class="w-full h-48 md:h-72 object-cover rounded-lg mb-6"
                  width={1024} widths={[640, 1024]}
                  sizes="(min-width: 768px) 768px, 100vw"
                  format="webp"
                  quality={78}
                />
              )
            }

            <div class="flex flex-wrap items-center gap-2 mb-3">
              {post.data.category && (
                <span class="font-mono text-xs tracking-widest uppercase text-gold bg-gold/10 px-2.5 py-0.5 rounded-full font-semibold">
                  {post.data.category}
                </span>
              )}
            </div>

            <h1 class="text-3xl md:text-5xl font-display font-black text-ink leading-tight mb-4">
              {post.data.title}
            </h1>

            <p class="text-lg md:text-xl text-muted leading-relaxed mb-5">
              {post.data.description}
            </p>

            <div class="flex flex-wrap items-center gap-3 text-sm text-muted-dark">
              {post.data.author && (
                <span class="flex items-center gap-1">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                  {post.data.author}
                </span>
              )}
              {/* pubDate is a bare date parsed as UTC midnight; formatting it in
                  the build machine's zone printed the day before west of UTC. */}
              <span class="flex items-center gap-1">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                {t.publishedOn} {post.data.pubDate.toLocaleDateString(lang === 'fr' ? 'fr-CA' : 'en-CA', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
              </span>
            </div>

            {
              post.data.tags && post.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-1.5 mt-4">
                  {post.data.tags.map((tag: string) => (
                    <span class="tag-pill">{tag}</span>
                  ))}
                </div>
              )
            }

            {/* Language Switcher for individual post */}
            <div class="mt-6 pt-4 border-t border-border-light">
              <span class="text-xs text-muted mr-2">{t.langLabel}:</span>
              <a href={translatedUrl} class="lang-switch-btn" data-set-lang={otherLang} hreflang={otherLang} lang={otherLang}>
                {otherLangLabel}
              </a>
            </div>
          </header>

          <div class="blog-content">
            <slot />
          </div>

          <footer class="mt-12 pt-8 border-t border-border-light">
            <a href={`/${lang}/blog`} class="inline-flex items-center gap-1.5 text-gold hover:text-gold-light transition-colors font-semibold">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
              {t.backToBlog}
            </a>
          </footer>
        </article>
      ) : (
        /* Blog Listing Layout */
        <div class="max-w-5xl mx-auto px-4 md:px-6 py-8 md:py-12">
          <header class="mb-10 md:mb-14 text-center">
            <h1 class="text-3xl md:text-5xl font-display font-black text-ink mb-4">{pageTitle}</h1>
            <p class="text-lg text-muted max-w-2xl mx-auto">{pageDesc}</p>
          </header>
          <slot />
        </div>
      )
    }
  </main>

  <!-- Blog Footer -->
  <footer class="bg-ink text-cream py-10 px-6 text-center mt-12">
    <div class="max-w-3xl mx-auto">
      <p class="text-gold text-sm font-bold mb-2">TEAM CANADA · ICC 2027 · LYON</p>
      <ul class="flex flex-wrap justify-center gap-x-5 gap-y-1 text-xs text-text-muted mb-3">
        <li><a href={legalPrefix + '/privacy'} class="hover:text-gold transition-colors">{t.privacy}</a></li>
        <li><a href={legalPrefix + '/terms'} class="hover:text-gold transition-colors">{t.terms}</a></li>
        <li><a href={legalPrefix + '/accessibility'} class="hover:text-gold transition-colors">{t.accessibility}</a></li>
      </ul>
      <p class="text-text-muted text-xs">© {COPYRIGHT_YEAR} Team Canada ICC. <span>{lang === 'fr' ? 'Tous droits réservés.' : 'All rights reserved.'}</span></p>
    </div>
  </footer>

  <!-- Persistent CTA, mobile only -->
  <StickyCta href={lang === 'fr' ? '/fr/sponsor' : '/sponsor'} static={lang} />

  <!-- Remember an explicit language choice; see the redirect in Layout.astro. -->
  <script is:inline>
    document.addEventListener('click', function (e) {
      var link = e.target.closest('[data-set-lang]');
      if (!link) return;
      try { localStorage.setItem('tc-lang', link.getAttribute('data-set-lang')); } catch (err) {}
    });
  </script>

</body>
</html>