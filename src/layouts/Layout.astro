---
// Production layout: vertical-nav rail + EN/FR language toggle,
// scroll-to-top, and all interactive page scripts (form handling,
// scroll spy, tier/comparison collapse, impact dashboard).
import '../styles/global.css';
import StatusStrip from '../components/StatusStrip.astro';
import StickyCta from '../components/StickyCta.astro';

interface Props {
  /** Where the status strip and the persistent mobile CTA point. Pages that
      already are the sponsor page pass an in-page anchor instead. */
  ctaHref?: string;
  /** Set false on pages whose own content already carries the ask — /sponsor
      puts the form in its hero, so a sticky bar would duplicate it. */
  stickyCta?: boolean;
  title?: string;
  titleEn?: string;
  titleFr?: string;
  description?: string;
  descriptionEn?: string;
  descriptionFr?: string;
}

const {
  ctaHref = '/sponsor',
  stickyCta = true,
  title = 'Team Canada · ICC · Lyon 2027',
  titleEn = 'Team Canada · ICC · Lyon 2027',
  titleFr = 'Équipe Canada · ICC · Lyon 2027',
  description = 'After a ten-year absence, Canada returns to the International Catering Cup in Lyon. Become a partner and help bring Canada back to the world stage.',
  descriptionEn = description,
  descriptionFr = "Après dix ans d'absence, le Canada revient à l'International Catering Cup à Lyon. Devenez partenaire et aidez à ramener le Canada sur la scène mondiale.",
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title data-lang-en={titleEn} data-lang-fr={titleFr}>{title}</title>
  <meta name="description" content={description} data-lang-en-desc={descriptionEn} data-lang-fr-desc={descriptionFr}>
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</head>
<body class="bg-cream text-body font-sans antialiased overflow-x-hidden">
  <StatusStrip href={ctaHref} />

  <slot />

  <!-- Persistent CTA, mobile only -->
  {stickyCta && <StickyCta href={ctaHref} />}

  <!-- Scroll-to-top button -->
  <button id="scroll-top-btn" class="scroll-top-btn" aria-label="Scroll to top">
    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7"/></svg>
  </button>

  <!-- Global Scripts -->
  <script is:inline>
    var currentLang = 'en';

    function positionLangThumbs(skipTransition) {
      document.querySelectorAll('.lang-rail, .vn-lang').forEach(function(group) {
        var thumb = group.querySelector('.lang-thumb');
        var active = group.querySelector('.lang-btn.active');
        if (!thumb || !active) return;
        if (skipTransition) thumb.classList.add('no-transition');
        thumb.style.width = active.offsetWidth + 'px';
        thumb.style.height = active.offsetHeight + 'px';
        thumb.style.transform = 'translate(' + active.offsetLeft + 'px,' + active.offsetTop + 'px)';
        if (skipTransition) {
          // force layout so the no-transition rule applies before it's removed
          void thumb.offsetWidth;
          thumb.classList.remove('no-transition');
        }
      });
    }

    function setLang(lang, skipThumbTransition) {
      currentLang = lang;
      document.documentElement.lang = lang;
      document.querySelectorAll('.lang-btn').forEach(function(btn) {
        var isActive = btn.textContent.trim().toLowerCase() === lang;
        btn.classList.toggle('active', isActive);
        btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      });
      positionLangThumbs(skipThumbTransition);
      document.querySelectorAll('[data-lang-en]').forEach(function(el) {
        var fr = el.getAttribute('data-lang-fr'), en = el.getAttribute('data-lang-en');
        if (lang === 'fr' && fr) el.innerHTML = fr;
        else if (lang === 'en' && en) el.innerHTML = en;
      });
      document.querySelectorAll('[data-lang-en-placeholder]').forEach(function(el) {
        var fr = el.getAttribute('data-lang-fr-placeholder'), en = el.getAttribute('data-lang-en-placeholder');
        el.placeholder = (lang === 'fr' && fr) ? fr : en;
      });
      var md = document.querySelector('meta[name="description"]');
      var de = md.getAttribute('data-lang-en-desc') || md.getAttribute('content');
      if (!md.getAttribute('data-lang-en-desc')) md.setAttribute('data-lang-en-desc', de);
      var df = md.getAttribute('data-lang-fr-desc') || "Après dix ans d'absence, le Canada revient à l'International Catering Cup à Lyon. Devenez partenaire et aidez à ramener le Canada sur la scène mondiale.";
      if (!md.getAttribute('data-lang-fr-desc')) md.setAttribute('data-lang-fr-desc', df);
      md.content = lang === 'fr' ? df : de;
      var te = document.querySelector('title');
      var tEn = te.getAttribute('data-lang-en') || 'Team Canada · ICC · Lyon 2027';
      var tFr = te.getAttribute('data-lang-fr') || 'Équipe Canada · ICC · Lyon 2027';
      document.title = lang === 'fr' ? tFr : tEn;
      try { localStorage.setItem('tc-lang', lang); } catch(e) {}
    }

    (function() {
      var sv; try { sv = localStorage.getItem('tc-lang'); } catch(e) {}
      if (!sv && navigator.language && navigator.language.startsWith('fr')) sv = 'fr';
      if (sv === 'fr' || sv === 'en') setLang(sv, true);
      else positionLangThumbs(true);
      window.addEventListener('load', function() { positionLangThumbs(true); });
      window.addEventListener('resize', function() { positionLangThumbs(true); });
    })();

    /* In-page anchor links scroll smoothly without ever touching the URL bar/hash */
    document.addEventListener('click', function(e) {
      var a = e.target.closest('a[href^="#"]');
      if (!a) return;
      var id = a.getAttribute('href').slice(1);
      if (!id) return;
      var target = document.getElementById(id);
      if (!target) return;
      e.preventDefault();
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    /* Form handling */
    var form = document.getElementById('inquiry-form');
    var fstatus = document.getElementById('form-status');
    var submitBtn = form ? form.querySelector('button[type="submit"]') : null;
    /* Read the button's own labels rather than repeating them here — hardcoded
       copies silently reverted the button to a previous wording after every
       submission. */
    var submitLabelEn = submitBtn ? submitBtn.getAttribute('data-lang-en') : '';
    var submitLabelFr = submitBtn ? submitBtn.getAttribute('data-lang-fr') : '';
    if (form && submitBtn) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        var nm = document.getElementById('name').value.trim();
        var em = document.getElementById('email').value.trim();
        var errEn = 'Please fill in all required fields.';
        var errFr = 'Veuillez remplir tous les champs obligatoires.';
        if (!nm || !em) { showStatus(currentLang === 'fr' ? errFr : errEn, 'error'); return; }
        var consentEl = form.querySelector('input[name="privacy_consent"]');
        if (consentEl && !consentEl.checked) {
          showStatus(currentLang === 'fr' ? 'Vous devez accepter l\'avis de confidentialité avant de soumettre votre demande.' : 'You must agree to the Privacy Notice before submitting your inquiry.', 'error');
          return;
        }
        submitBtn.disabled = true;
        submitBtn.textContent = currentLang === 'fr' ? 'Envoi en cours...' : 'Sending...';
        fstatus.className = 'hidden';
        var fd = new FormData(form);
        var data = Object.fromEntries(fd.entries());
        fetch('/api/inquiry', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) })
          .then(function(r) { return r.json().then(function(j) { return { ok: r.ok, result: j }; }); })
          .then(function(rr) {
            if (rr.ok && rr.result.success) {
              showStatus(currentLang === 'fr' ? 'Merci ! Le dossier de partenariat est en route vers votre boîte de réception. Vérifiez vos indésirables au besoin.' : 'Thank you! The partnership package is on its way to your inbox. Check your spam folder if it does not arrive.', 'success');
              form.reset();
            } else {
              showStatus(rr.result.message || (currentLang === 'fr' ? 'Une erreur est survenue. Veuillez réessayer ou nous contacter directement au 514-573-6758.' : 'Something went wrong. Please try again or contact us directly at 514-573-6758.'), 'error');
            }
          })
          .catch(function() {
            showStatus(currentLang === 'fr' ? 'Impossible d\'envoyer votre demande. Veuillez réessayer ou nous contacter directement au 514-573-6758.' : 'Unable to send your inquiry. Please try again or contact us directly at 514-573-6758.', 'error');
          })
          .then(function() { submitBtn.disabled = false; submitBtn.textContent = currentLang === 'fr' ? submitLabelFr : submitLabelEn; });
      });
    }

    function showStatus(msg, type) {
      if (!fstatus) return;
      fstatus.textContent = msg;
      fstatus.className = 'text-sm font-semibold p-3 mb-4 rounded-md ' + (type === 'success' ? 'bg-green-100 text-green-800 border border-green-300' : 'bg-red-100 text-red-800 border border-red-300');
      fstatus.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    /* Scroll spy + scroll-to-top toggle */
    var secs = document.querySelectorAll('section[id]');
    var nls = document.querySelectorAll('.nav-link');
    window.addEventListener('scroll', function() {
      var cur = '', sy = window.scrollY + 120;
      secs.forEach(function(s) { var t = s.offsetTop, h = s.offsetHeight; if (sy >= t && sy < (t + h)) cur = s.getAttribute('id'); });
      nls.forEach(function(l) { l.classList.toggle('text-gold', l.getAttribute('href') === '#' + cur); l.classList.toggle('text-text-muted', l.getAttribute('href') !== '#' + cur); });
      var stb = document.getElementById('scroll-top-btn');
      if (stb) stb.classList.toggle('visible', window.scrollY > 500);
    });

    /* Scroll-to-top click */
    var stbEl = document.getElementById('scroll-top-btn');
    if (stbEl) stbEl.addEventListener('click', function() { window.scrollTo({ top: 0, behavior: 'smooth' }); });

    /* Vertical nav mobile drawer */
    (function() {
      var btn = document.getElementById('vn-menu-btn');
      var drawer = document.getElementById('vn-drawer');
      if (!btn || !drawer) return;
      function toggle(open) {
        var isOpen = typeof open === 'boolean' ? open : !drawer.classList.contains('open');
        drawer.classList.toggle('open', isOpen);
        drawer.inert = !isOpen;
        btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        drawer.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
        document.body.style.overflow = isOpen ? 'hidden' : '';
        document.body.classList.toggle('vn-open', isOpen);
        // hide the left language rail while the drawer is open (narrow screens)
        var lr = document.querySelector('.lang-rail');
        if (lr) lr.style.display = isOpen ? 'none' : '';
      }
      btn.addEventListener('click', function(e) { e.stopPropagation(); toggle(); });
      var closeBtn = document.getElementById('vn-close-btn');
      if (closeBtn) closeBtn.addEventListener('click', function() { toggle(false); });
      drawer.querySelectorAll('a').forEach(function(a) { a.addEventListener('click', function() { toggle(false); }); });
      document.addEventListener('click', function(e) {
        if (drawer.classList.contains('open') && !drawer.contains(e.target) && !btn.contains(e.target)) toggle(false);
      });
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && drawer.classList.contains('open')) toggle(false);
      });
    })();

    /* 🇨🇦 */
    console.log('%c🍁 %cEh! Thanks for checking under the hood, friend. %c· Team Canada %c🇨🇦',
      'font-size:1.5em;', 'color:#cc1f2d;font-weight:bold;font-size:1.1em;', 'color:#c2a15c;', 'font-size:1.5em;');
    console.log('%cProudly crafted in Montréal · Allez Canada! 🏒', 'color:#7a7461;font-style:italic;');

    /* ===== Tier Benefit Expand/Collapse ===== */
    function toggleBenefits(listId, btn) {
      var list = document.getElementById(listId);
      if (!list) return;
      var hidden = list.querySelectorAll('.benefit-hidden');
      var isExpanded = btn.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        hidden.forEach(function(li) { li.classList.add('benefit-hidden'); li.classList.remove('benefit-visible'); });
        btn.setAttribute('aria-expanded', 'false');
        btn.classList.remove('expanded');
        var showText = btn.querySelector('span');
        var enPhrases = { 'lead': 'Show all 11 benefits', 'premier': 'Show all 10 benefits', 'official': 'Show all 8 benefits', 'supporting': 'Show all 6 benefits' };
        var frPhrases = { 'lead': 'Afficher les 11 avantages', 'premier': 'Afficher les 10 avantages', 'official': 'Afficher les 8 avantages', 'supporting': 'Afficher les 6 avantages' };
        var key = listId.replace('-benefits', '');
        if (showText) showText.textContent = currentLang === 'fr' ? (frPhrases[key] || 'Afficher tout') : (enPhrases[key] || 'Show all');
      } else {
        hidden.forEach(function(li) { li.classList.remove('benefit-hidden'); li.classList.add('benefit-visible'); });
        btn.setAttribute('aria-expanded', 'true');
        btn.classList.add('expanded');
        var hideText = btn.querySelector('span');
        if (hideText) hideText.textContent = currentLang === 'fr' ? 'Réduire' : 'Show less';
      }
    }

    /* ===== Comparison Table Collapse ===== */
    function toggleComparison(btn) {
      var wrap = document.getElementById('comparison-table-wrap');
      if (!wrap) return;
      var isExpanded = btn.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        wrap.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
        btn.classList.remove('expanded');
      } else {
        wrap.classList.add('open');
        btn.setAttribute('aria-expanded', 'true');
        btn.classList.add('expanded');
      }
    }

    /* ===== Sponsor FAQ accordion =====
       Delegated so it costs nothing on pages without a FAQ. Each trigger
       owns the .collapsible-content that follows it. */
    document.addEventListener('click', function(e) {
      var trigger = e.target.closest('.faq-trigger');
      if (!trigger) return;
      var panel = trigger.nextElementSibling;
      if (!panel || !panel.classList.contains('collapsible-content')) return;
      var isOpen = trigger.getAttribute('aria-expanded') === 'true';
      trigger.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
      trigger.classList.toggle('expanded', !isOpen);
      panel.classList.toggle('open', !isOpen);
    });

    /* ═══════════════════════════════════════════════════════
       IMPACT DASHBOARD - Interactive JavaScript
       ═══════════════════════════════════════════════════════ */

    /* --- 1. Budget Bar Fill Animations (Intersection Observer) --- */
    (function() {
      var bars = document.querySelectorAll('.budget-bar-fill');
      if (!bars.length) return;

      var barObserver = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            var bar = entry.target;
            var targetWidth = bar.getAttribute('data-width') || '0%';
            var scale = parseFloat(targetWidth) / 100;
            bar.style.transform = 'scaleX(' + scale + ')';
            barObserver.unobserve(bar);
          }
        });
      }, { threshold: 0.3 });

      bars.forEach(function(bar) { barObserver.observe(bar); });
    })();

    /* --- 2. Budget Category Hover/Click → Detail Card Update --- */
    (function() {
      var categories = document.querySelectorAll('.budget-category');
      var detailDefault = document.getElementById('budget-detail-default');
      var detailContent = document.getElementById('budget-detail-content');
      var detailIcon = document.getElementById('budget-detail-icon');
      var detailTitle = document.getElementById('budget-detail-title');
      var detailPct = document.getElementById('budget-detail-pct');
      var detailDesc = document.getElementById('budget-detail-desc');

      if (!categories.length || !detailContent) return;

      var categoryData = {
        training: {
          icon: '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.4 10.8h12.2v1.9a6.1 6.1 0 0 1-12.2 0v-1.9Z"/><path d="m15.6 11.6 5.2-2.4"/><circle cx="9.5" cy="14.4" r="1.9"/></svg>',
          titleEn: "Training & Ingredients",
          titleFr: "Entraînement et ingrédients",
          descEn: "Kitchen access, premium ingredients, specialized products, recipe testing, and repeated rehearsal sessions that refine every element of the competition program.",
          descFr: "Accès aux cuisines, ingrédients haut de gamme, produits spécialisés, tests de recettes et séances de répétition qui peaufine chaque élément du programme de compétition."
        },
        equipment: {
          icon: '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3 12 6l3-3 4.4 1.8a1.8 1.8 0 0 1 1.1 1.9l-.5 3.2h-2.6v10.9H6.6V9.9H4l-.5-3.2A1.8 1.8 0 0 1 4.6 4.8L9 3Z"/><path d="M12 6v14.8"/><circle cx="14.7" cy="11.4" r=".85"/><circle cx="14.7" cy="15.4" r=".85"/></svg>',
          titleEn: "Equipment & Uniforms",
          titleFr: "Équipement et uniformes",
          descEn: "Professional-grade cookware, serving pieces, chef jackets, team apparel, and presentation materials that represent Canada on the world stage.",
          descFr: "Ustensiles de cuisine professionnels, pièces de service, vestes de chef, tenues d’équipe et matériel de présentation qui représentent le Canada sur la scène mondiale."
        },
        travel: {
          icon: '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15.4 13.4 11V5.1a1.7 1.7 0 0 0-3.4 0V11L2.4 15.4v2.2l7.6-2.2v3.5l-2.2 1.5v1.4l3.9-1 3.9 1v-1.4l-2.2-1.5v-3.5l7.6 2.2v-2.2Z"/></svg>',
          titleEn: "Travel & Logistics",
          titleFr: "Voyage et logistique",
          descEn: "Flights, hotels, ground transportation, equipment freight, and essential travel expenses for the team’s journey from Montréal to Lyon.",
          descFr: "Vols, hôtels, transport terrestre, fret d’équipement et dépenses de voyage essentielles pour le parcours de l’équipe de Montréal à Lyon."
        },
        mentorship: {
          icon: '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 3.3 2.7 5.5 6 .9-4.3 4.2 1 6-5.4-2.8-5.4 2.8 1-6-4.3-4.2 6-.9L12 3.3Z"/></svg>',
          titleEn: "Youth Mentorship",
          titleFr: "Mentorat jeunesse",
          descEn: "Apprentice and junior cook development, culinary education outreach, and building the next generation of Canadian culinary talent alongside the national team.",
          descFr: "Développement des apprentis et jeunes cuisiniers, sensibilisation culinaire éducative et construction de la prochaine génération de talents culinaires canadiens aux côtés de l’équipe nationale."
        }
      };

      function updateDetailCard(category, pct) {
        var data = categoryData[category];
        if (!data) return;

        var isFr = (typeof currentLang !== 'undefined' && currentLang === 'fr');

        if (detailDefault) detailDefault.classList.add('hidden');
        detailContent.classList.remove('hidden');

        detailIcon.innerHTML = data.icon;
        detailTitle.textContent = isFr ? data.titleFr : data.titleEn;
        detailPct.textContent = pct + '%';
        detailDesc.textContent = isFr ? data.descFr : data.descEn;
      }

      function resetDetailCard() {
        if (detailDefault) detailDefault.classList.remove('hidden');
        detailContent.classList.add('hidden');
      }

      function setActive(catEl) {
        categories.forEach(function(c) { c.classList.remove('active'); });
        catEl.classList.add('active');
      }

      function clearActive() {
        categories.forEach(function(c) { c.classList.remove('active'); });
      }

      categories.forEach(function(cat) {
        cat.addEventListener('mouseenter', function() {
          var catKey = cat.getAttribute('data-category');
          var pct = cat.getAttribute('data-pct');
          updateDetailCard(catKey, pct);
          setActive(cat);
        });
        cat.addEventListener('mouseleave', function() {
          resetDetailCard();
          clearActive();
        });

        cat.addEventListener('click', function(e) {
          var catKey = cat.getAttribute('data-category');
          var pct = cat.getAttribute('data-pct');
          if (cat.classList.contains('active')) {
            resetDetailCard();
            clearActive();
          } else {
            updateDetailCard(catKey, pct);
            setActive(cat);
          }
        });

        cat.addEventListener('keydown', function(e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            cat.click();
          }
        });
      });
    })();

  </script>
</body>
</html>
