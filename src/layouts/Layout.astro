---
// Production layout: status strip, persistent mobile CTA, scroll-to-top, and
// the page scripts (form handling, scroll spy, mobile drawer, FAQ accordion).
//
// Pages render in English with data-lang-fr alternates; the /fr/* twins of
// each page get their French copy swapped in at build time by
// src/middleware.ts. Nothing here translates at runtime.
import '../styles/fonts.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import StatusStrip from '../components/StatusStrip.astro';
import StickyCta from '../components/StickyCta.astro';
import ogSource from '../assets/team.jpg';
import { SITE_URL, alternatePath, publicPath, PHONE_DISPLAY } from '../consts';

interface Props {
  /** Where the status strip and the persistent mobile CTA point. Pages that
      already are the sponsor page pass an in-page anchor instead. */
  ctaHref?: string;
  /** Set false on pages whose own content already carries the ask — /sponsor
      puts the form in its hero, so a sticky bar would duplicate it. */
  stickyCta?: boolean;
  titleEn?: string;
  titleFr?: string;
  descriptionEn?: string;
  descriptionFr?: string;
  /** Keep the page out of search results (design experiments, 404). */
  noindex?: boolean;
}

const {
  ctaHref = '/sponsor',
  stickyCta = true,
  titleEn = 'Team Canada · ICC · Lyon 2027',
  titleFr = 'Équipe Canada · ICC · Lyon 2027',
  descriptionEn = 'After a ten-year absence, Canada returns to the International Catering Cup in Lyon. Become a partner and help bring Canada back to the world stage.',
  descriptionFr = "Après dix ans d'absence, le Canada revient à l'International Catering Cup à Lyon. Devenez partenaire et aidez à ramener le Canada sur la scène mondiale.",
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL(SITE_URL);
const path = publicPath(Astro.url.pathname);
const isFr = path === '/fr' || path.startsWith('/fr/');
const lang = isFr ? 'fr' : 'en';
const enPath = alternatePath(path, 'en');
const frPath = alternatePath(path, 'fr');
const canonical = new URL(path, site).href;

const og = await getImage({ src: ogSource, width: 1200, format: 'jpg', quality: 80 });
const ogImage = new URL(og.src, site).href;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!-- Tints the mobile browser chrome to match the status strip, the topmost
       thing on every page. Hardcoded because meta cannot read a custom
       property — keep in step with --color-olive in global.css. -->
  <meta name="theme-color" content="#463f31">
  <meta name="color-scheme" content="light">
  <title data-lang-en={titleEn} data-lang-fr={titleFr}>{titleEn}</title>
  <meta name="description" content={descriptionEn} data-lang-fr-desc={descriptionFr}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  {noindex
    ? <meta name="robots" content="noindex">
    : <link rel="canonical" href={canonical}>}
  {enPath && frPath && (
    <>
      <link rel="alternate" hreflang="en" href={new URL(enPath, site).href}>
      <link rel="alternate" hreflang="fr" href={new URL(frPath, site).href}>
      <link rel="alternate" hreflang="x-default" href={new URL(enPath, site).href}>
    </>
  )}
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Team Canada ICC">
  <meta property="og:locale" content={isFr ? 'fr_CA' : 'en_CA'}>
  <meta property="og:url" content={canonical}>
  <meta property="og:title" content={titleEn} data-lang-fr-desc={titleFr}>
  <meta property="og:description" content={descriptionEn} data-lang-fr-desc={descriptionFr}>
  <meta property="og:image" content={ogImage}>
  <meta name="twitter:card" content="summary_large_image">
  {/* First visit with a French browser and no stored choice: go to the
      French twin before anything paints. An explicit choice made with the
      language toggle is remembered and always wins. */}
  {lang === 'en' && frPath && (
    <script is:inline define:vars={{ frPath }}>
      try {
        if (!localStorage.getItem('tc-lang') && (navigator.language || '').toLowerCase().startsWith('fr')) {
          location.replace(frPath + location.hash);
        }
      } catch (e) {}
    </script>
  )}
</head>
<body class="bg-cream text-body font-sans antialiased overflow-x-hidden">
  {/* Every page wraps its content in <main id="main" tabindex="-1">, so
      keyboard users can jump past the strip and the nav (WCAG 2.4.1). */}
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[200] focus:bg-gold focus:text-ink focus:px-4 focus:py-2 focus:font-semibold" data-lang-en="Skip to content" data-lang-fr="Aller au contenu">Skip to content</a>
  <StatusStrip href={ctaHref} />

  <slot />

  <!-- Persistent CTA, mobile only -->
  {stickyCta && <StickyCta href={ctaHref} />}

  <!-- Scroll-to-top button -->
  <button id="scroll-top-btn" class="scroll-top-btn" aria-label="Scroll to top" data-lang-fr-aria="Retour en haut">
    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7"/></svg>
  </button>

  <!-- Global Scripts -->
  <script is:inline define:vars={{ phone: PHONE_DISPLAY }}>
    var currentLang = document.documentElement.lang === 'fr' ? 'fr' : 'en';

    function positionLangThumbs(skipTransition) {
      document.querySelectorAll('.lang-rail, .vn-lang').forEach(function(group) {
        var thumb = group.querySelector('.lang-thumb');
        var active = group.querySelector('.lang-btn.active');
        if (!thumb || !active) return;
        if (skipTransition) thumb.classList.add('no-transition');
        thumb.style.width = active.offsetWidth + 'px';
        thumb.style.height = active.offsetHeight + 'px';
        thumb.style.transform = 'translate(' + active.offsetLeft + 'px,' + active.offsetTop + 'px)';
        if (skipTransition) {
          // force layout so the no-transition rule applies before it's removed
          void thumb.offsetWidth;
          thumb.classList.remove('no-transition');
        }
      });
    }
    positionLangThumbs(true);
    window.addEventListener('load', function() { positionLangThumbs(true); });
    window.addEventListener('resize', function() { positionLangThumbs(true); });

    /* The toggles are plain links to the other language's page; remember the
       choice so the first-visit redirect in <head> never overrides it. */
    document.addEventListener('click', function(e) {
      var link = e.target.closest('[data-set-lang]');
      if (!link) return;
      try { localStorage.setItem('tc-lang', link.getAttribute('data-set-lang')); } catch (err) {}
    });

    /* In-page anchor links scroll smoothly without ever touching the URL bar/hash */
    document.addEventListener('click', function(e) {
      var a = e.target.closest('a[href^="#"]');
      if (!a) return;
      var id = a.getAttribute('href').slice(1);
      if (!id) return;
      var target = document.getElementById(id);
      if (!target) return;
      e.preventDefault();
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      /* Scrolling alone leaves keyboard focus behind; a focusable target
         (the skip link's <main tabindex="-1">) has to receive it too. */
      if (target.hasAttribute('tabindex')) target.focus({ preventScroll: true });
    });

    /* Form handling */
    var form = document.getElementById('inquiry-form');
    var fstatus = document.getElementById('form-status');
    var submitBtn = form ? form.querySelector('button[type="submit"]') : null;
    /* Read the button's own (already localized) label rather than repeating
       it here — hardcoded copies silently reverted the button to a previous
       wording after every submission. */
    var submitLabel = submitBtn ? submitBtn.textContent : '';
    var fr = currentLang === 'fr';
    if (form && submitBtn) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        var nm = document.getElementById('name').value.trim();
        var em = document.getElementById('email').value.trim();
        if (!nm || !em) {
          showStatus(fr ? 'Veuillez remplir tous les champs obligatoires.' : 'Please fill in all required fields.', 'error');
          return;
        }
        var consentEl = form.querySelector('input[name="privacy_consent"]');
        if (consentEl && !consentEl.checked) {
          showStatus(fr ? 'Vous devez accepter l\'avis de confidentialité avant de soumettre votre demande.' : 'You must agree to the Privacy Notice before submitting your inquiry.', 'error');
          return;
        }
        submitBtn.disabled = true;
        submitBtn.textContent = fr ? 'Envoi en cours...' : 'Sending...';
        fstatus.className = 'hidden';
        var data = Object.fromEntries(new FormData(form).entries());
        /* The endpoint picks the email template and its error language from this. */
        data.lang = currentLang;
        fetch('/api/inquiry', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) })
          .then(function(r) { return r.json().then(function(j) { return { ok: r.ok, result: j }; }); })
          .then(function(rr) {
            if (rr.ok && rr.result.success) {
              /* Never promise an inbox the endpoint could not reach — emailed
                 tells us whether the package actually went out. */
              var msg = rr.result.emailed
                ? (fr ? 'Merci ! Le dossier de partenariat est en route vers votre boîte de réception. Vérifiez vos indésirables au besoin, ou téléchargez-le dès maintenant :' : 'Thank you! The partnership package is on its way to your inbox. Check your spam folder if it does not arrive, or download it right now:')
                : (fr ? 'Merci ! Téléchargez le dossier de partenariat ci-dessous. Nous revenons vers vous par courriel.' : 'Thank you! Download the partnership package below. We will follow up by email.');
              /* A mocked run must never read as a real one -- the tester would
                 sit waiting for an email that was only ever logged. */
              if (rr.result.mocked) {
                msg = (fr ? "MODE TEST — aucun courriel n'a été envoyé. " : 'TEST MODE — no email was sent. ') + msg;
              }
              showStatus(msg, 'success', rr.result.download);
              form.reset();
            } else {
              showStatus(rr.result.message || (fr ? 'Une erreur est survenue. Veuillez réessayer ou nous contacter directement au ' + phone + '.' : 'Something went wrong. Please try again or contact us directly at ' + phone + '.'), 'error');
            }
          })
          .catch(function() {
            showStatus(fr ? 'Impossible d\'envoyer votre demande. Veuillez réessayer ou nous contacter directement au ' + phone + '.' : 'Unable to send your inquiry. Please try again or contact us directly at ' + phone + '.', 'error');
          })
          .then(function() {
            submitBtn.disabled = false;
            submitBtn.textContent = submitLabel;
            resetTurnstile();
          });
      });
    }

    /* Turnstile tokens are single-use and expire after five minutes. Without a
       reset the widget keeps handing back the token it already spent, so every
       attempt after the first fails siteverify with timeout-or-duplicate --
       which surfaces as "Security check failed" no matter what the visitor does. */
    function resetTurnstile() {
      try {
        var widget = document.querySelector('.cf-turnstile');
        if (widget && window.turnstile) window.turnstile.reset(widget);
      } catch (e) { /* the widget may not have rendered; nothing to reset */ }
    }

    function showStatus(msg, type, downloadHref) {
      if (!fstatus) return;
      /* Assigning textContent also clears the link left by a previous submit. */
      fstatus.textContent = msg;
      fstatus.className = 'text-sm font-semibold p-3 mb-4 rounded-md ' + (type === 'success' ? 'bg-green-100 text-green-800 border border-green-300' : 'bg-red-100 text-red-800 border border-red-300');
      /* Built as a node, never as markup — nothing from a response payload goes
         through innerHTML. It is also a link the visitor clicks rather than an
         automatic window.open(), which pop-up blockers eat once the original
         click gesture has expired during the fetch. */
      if (downloadHref) {
        var dl = document.createElement('a');
        dl.href = downloadHref;
        dl.setAttribute('download', '');
        dl.className = 'block mt-2 underline';
        dl.textContent = fr ? 'Télécharger le dossier de partenariat (PDF)' : 'Download the partnership package (PDF)';
        fstatus.appendChild(dl);
      }
      fstatus.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    /* Scroll spy + scroll-to-top toggle */
    var secs = document.querySelectorAll('section[id]');
    var nls = document.querySelectorAll('.nav-link');
    var stb = document.getElementById('scroll-top-btn');
    window.addEventListener('scroll', function() {
      var cur = '', sy = window.scrollY + 120;
      secs.forEach(function(s) { var t = s.offsetTop, h = s.offsetHeight; if (sy >= t && sy < (t + h)) cur = s.getAttribute('id'); });
      nls.forEach(function(l) { l.classList.toggle('text-gold', l.getAttribute('href') === '#' + cur); l.classList.toggle('text-text-muted', l.getAttribute('href') !== '#' + cur); });
      if (stb) stb.classList.toggle('visible', window.scrollY > 500);
    }, { passive: true });

    /* Scroll-to-top click */
    if (stb) stb.addEventListener('click', function() { window.scrollTo({ top: 0, behavior: 'smooth' }); });

    /* Vertical nav mobile drawer */
    (function() {
      var btn = document.getElementById('vn-menu-btn');
      var drawer = document.getElementById('vn-drawer');
      if (!btn || !drawer) return;
      function toggle(open) {
        var isOpen = typeof open === 'boolean' ? open : !drawer.classList.contains('open');
        drawer.classList.toggle('open', isOpen);
        drawer.inert = !isOpen;
        btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        drawer.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
        document.body.style.overflow = isOpen ? 'hidden' : '';
        document.body.classList.toggle('vn-open', isOpen);
        // hide the left language rail while the drawer is open (narrow screens)
        var lr = document.querySelector('.lang-rail');
        if (lr) lr.style.display = isOpen ? 'none' : '';
        if (isOpen) positionLangThumbs(true);
        /* Keyboard focus follows the drawer: into it on open, and back to the
           button on close if it was inside, so it never sits on an inert node. */
        if (isOpen) {
          var closeEl = document.getElementById('vn-close-btn');
          if (closeEl) closeEl.focus();
        } else if (drawer.contains(document.activeElement)) {
          btn.focus();
        }
      }
      btn.addEventListener('click', function(e) { e.stopPropagation(); toggle(); });
      var closeBtn = document.getElementById('vn-close-btn');
      if (closeBtn) closeBtn.addEventListener('click', function() { toggle(false); });
      drawer.querySelectorAll('a').forEach(function(a) { a.addEventListener('click', function() { toggle(false); }); });
      document.addEventListener('click', function(e) {
        if (drawer.classList.contains('open') && !drawer.contains(e.target) && !btn.contains(e.target)) toggle(false);
      });
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && drawer.classList.contains('open')) toggle(false);
      });
    })();

    /* ===== Sponsor FAQ accordion =====
       Delegated so it costs nothing on pages without a FAQ. Each trigger
       owns the .collapsible-content that follows it. */
    document.addEventListener('click', function(e) {
      var trigger = e.target.closest('.faq-trigger');
      if (!trigger) return;
      var panel = trigger.nextElementSibling;
      if (!panel || !panel.classList.contains('collapsible-content')) return;
      var isOpen = trigger.getAttribute('aria-expanded') === 'true';
      trigger.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
      trigger.classList.toggle('expanded', !isOpen);
      panel.classList.toggle('open', !isOpen);
    });

    /* 🇨🇦 */
    console.log('%c🍁 %cEh! Thanks for checking under the hood, friend. %c· Team Canada %c🇨🇦',
      'font-size:1.5em;', 'color:#cc1f2d;font-weight:bold;font-size:1.1em;', 'color:#c2a15c;', 'font-size:1.5em;');
    console.log('%cProudly crafted in Montréal · Allez Canada! 🏒', 'color:#7a7461;font-style:italic;');
  </script>
</body>
</html>
