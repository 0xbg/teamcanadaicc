---
// ===== FOOTER =====
interface Props {
  ctaHref?: string;
}

const { ctaHref = '#inquiry' } = Astro.props;
import Icon from './Icon.astro';
import LangRail from './LangRail.astro';
---
<footer class="py-20 md:py-28 px-6 bg-ink text-cream">
  <div class="max-w-3xl mx-auto text-center">
    <h2 class="text-3xl md:text-5xl font-bold mb-6 font-display" data-lang-en="Let's Bring Canada Back to the World Stage" data-lang-fr="Ramenez le Canada sur la scène mondiale">Let's Bring Canada Back to the World Stage</h2>
    <p class="text-text-muted text-lg leading-relaxed mb-10 max-w-2xl mx-auto" data-lang-en="Team Canada is going back to Lyon, and we're bringing partners with us. Be part of the comeback." data-lang-fr="Équipe Canada retourne à Lyon, et nous emmenons nos partenaires avec nous. Faites partie du retour.">Team Canada is going back to Lyon, and we're bringing partners with us. Be part of the comeback.</p>
    <a href={ctaHref} class="inline-block bg-gold text-ink px-8 py-4 font-semibold text-lg hover:bg-gold-light transition-colors duration-200 btn-cta" data-lang-en="Partner With Team Canada" data-lang-fr="Devenez partenaire d'Équipe Canada">Partner With Team Canada</a>
    <p class="text-text-muted text-xs mt-4" data-lang-en="Lyon · January 2027 · The next Cup is 2029" data-lang-fr="Lyon · janvier 2027 · La prochaine Coupe est en 2029">Lyon · January 2027 · The next Cup is 2029</p>
  </div>

  <div class="max-w-5xl mx-auto border-t border-border-dark mt-16 pt-14">
    <div class="grid gap-10 sm:grid-cols-3 text-left">
      <div>
        <div class="flex items-center gap-2 mb-3">
          <span class="text-gold leading-none" aria-hidden="true"><Icon name="maple" size={20} /></span>
          <p class="text-gold text-base font-bold tracking-wide">TEAM CANADA</p>
        </div>
        <p class="text-text-muted text-sm">ICC 2027 · Lyon</p>
      </div>

      <div>
        <h4 class="font-mono text-xs uppercase tracking-[0.2em] text-gold mb-4" data-lang-en="Quick Links" data-lang-fr="Liens rapides">Quick Links</h4>
        <ul class="space-y-2.5 text-sm text-text-muted">
          <li><a href="/sponsor" class="hover:text-gold transition-colors" data-lang-en="Sponsorship" data-lang-fr="Commandite">Sponsorship</a></li>
          <li><a href="/en/blog" class="hover:text-gold transition-colors" data-lang-en="Blog" data-lang-fr="Blogue">Blog</a></li>
          <li><a href="/privacy" class="hover:text-gold transition-colors" data-lang-en="Privacy Notice" data-lang-fr="Avis de confidentialité">Privacy Notice</a></li>
          <li><a href="/terms" class="hover:text-gold transition-colors" data-lang-en="Terms of Service" data-lang-fr="Conditions d'utilisation">Terms of Service</a></li>
          <li><a href="/accessibility" class="hover:text-gold transition-colors" data-lang-en="Accessibility" data-lang-fr="Accessibilité">Accessibility</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-mono text-xs uppercase tracking-[0.2em] text-gold mb-4" data-lang-en="Contact" data-lang-fr="Contact">Contact</h4>
        <div class="flex flex-col gap-2.5">
          <a href="mailto:privacy@teamcanadaicc.ca" class="inline-flex items-center gap-2 text-sm text-text-muted border border-border-dark btn-cta px-3.5 py-2 hover:border-gold hover:text-gold transition-colors w-fit">
            <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 6.5h18v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-11Zm0 0 9 6.5 9-6.5" /></svg>
            privacy@teamcanadaicc.ca
          </a>
          <a href="tel:+15145736758" class="inline-flex items-center gap-2 text-sm text-text-muted border border-border-dark btn-cta px-3.5 py-2 hover:border-gold hover:text-gold transition-colors w-fit">
            <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L14 13l5 2v4a2 2 0 0 1-2 2C9.5 21 3 14.5 3 6a2 2 0 0 1 1-2Z" /></svg>
            514-573-6758
          </a>
          <a href="https://www.instagram.com/teamcanadaicc/" target="_blank" rel="noopener" aria-label="Instagram" class="inline-flex items-center gap-2 text-sm text-text-muted border border-border-dark btn-cta px-3.5 py-2 hover:border-gold hover:text-gold transition-colors w-fit">
            <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" stroke="none" /></svg>
            @teamcanadaicc
          </a>
        </div>
      </div>
    </div>

    <div class="border-t border-border-dark mt-12 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-text-muted text-xs order-2 sm:order-1">© 2026 Team Canada ICC. <span data-lang-en="All rights reserved." data-lang-fr="Tous droits réservés.">All rights reserved.</span></p>
      <LangRail />
    </div>
  </div>
</footer>