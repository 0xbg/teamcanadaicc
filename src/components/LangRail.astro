---
// ===== EN/FR SWITCHER =====
// Lives in the footer rather than floating over the page. Pages with a mobile
// drawer also carry a copy inside it (VerticalNav's .vn-lang row), which is
// the mobile route; the footer copy hides under that on small screens so the
// two never both appear.
//
// The buttons are links to the same page in the other language — each
// language is its own built page (see src/middleware.ts). Pages without a
// twin link to the other language's homepage. data-set-lang lets the
// Layout script remember the choice; data-keep-href stops the French build
// from rewriting the EN link.
import LangLinks from './LangLinks.astro';
---

<div class="lang-rail lang-rail--footer" role="group" aria-label="Language">
  <LangLinks />
</div>
