---
// The Comeback — a ten-year arc, not a roadmap.
// The rail is dotted and dim from 2017, then ignites at 2026 and runs
// solid gold to the end: the absence is legible in the geometry before
// a word of it is read. The "no Canadian entry" span is a real column,
// not a caption, because the empty years are the point of the section.
---

<section id="comeback" class="py-20 md:py-28 px-6 bg-ink text-cream overflow-hidden">
  <div class="max-w-6xl mx-auto">
    <p class="text-gold font-display italic text-lg mb-3 text-center" data-lang-en="A 10-Year Comeback Story" data-lang-fr="Un retour après 10 ans">A 10-Year Comeback Story</p>
    <h2 class="text-3xl md:text-5xl font-bold mb-6 font-display text-center" data-lang-en="Ten Years Off the Floor" data-lang-fr="Dix ans loin du parquet">Ten Years Off the Floor</h2>
    <p class="text-text-muted text-lg leading-relaxed max-w-3xl mx-auto mb-16 text-center" data-lang-en="Canada last cooked at the International Catering Cup in 2017. Ten years later, three chefs from Bar George are putting the country back on the floor in Lyon. This is the road between those two dates." data-lang-fr="Le Canada a cuisiné pour la dernière fois à l'International Catering Cup en 2017. Dix ans plus tard, trois chefs du Bar George remettent le pays sur le parquet, à Lyon. Voici la route entre ces deux dates.">Canada last cooked at the International Catering Cup in 2017. Ten years later, three chefs from Bar George are putting the country back on the floor in Lyon. This is the road between those two dates.</p>

    <div class="cb-spine">
      <!-- Decorative rail: the ordered list below carries the sequence. -->
      <div class="cb-rail" aria-hidden="true">
        <span class="cb-mark cb-mark--past"><i class="cb-dot"></i></span>
        <span class="cb-mark cb-mark--void"></span>
        <span class="cb-mark cb-mark--ignite"><i class="cb-dot"></i></span>
        <span class="cb-mark cb-mark--live"><i class="cb-dot"></i></span>
        <span class="cb-mark cb-mark--live cb-mark--last"><i class="cb-dot"></i></span>
      </div>

      <ol class="cb-nodes">
        <li class="cb-node cb-node--past">
          <p class="cb-year">2017</p>
          <p class="cb-where" data-lang-en="Lyon" data-lang-fr="Lyon">Lyon</p>
          <h3 class="cb-phase" data-lang-en="Last entry" data-lang-fr="Dernière inscription">Last entry</h3>
          <p class="cb-copy" data-lang-en="Canada's last team competes. Then the entries stop." data-lang-fr="La dernière équipe canadienne concourt. Puis les inscriptions cessent.">Canada's last team competes. Then the entries stop.</p>
        </li>

        <li class="cb-node cb-node--void">
          <p class="cb-void-span">2018 — 2025</p>
          <p class="cb-void-label" data-lang-en="no Canadian entry" data-lang-fr="aucune inscription canadienne">no Canadian entry</p>
        </li>

        <li class="cb-node">
          <p class="cb-year">2026</p>
          <p class="cb-where" data-lang-en="Montréal" data-lang-fr="Montréal">Montréal</p>
          <h3 class="cb-phase" data-lang-en="Preparation" data-lang-fr="Préparation">Preparation</h3>
          <p class="cb-copy" data-lang-en="Team selection, kitchen training, recipe development and the competition program. The longest phase by far, and where partner visibility starts." data-lang-fr="Sélection de l'équipe, entraînement en cuisine, développement des recettes et programme de compétition. De loin la phase la plus longue, et le début de la visibilité des partenaires.">Team selection, kitchen training, recipe development and the competition program. The longest phase by far, and where partner visibility starts.</p>
        </li>

        <li class="cb-node">
          <p class="cb-year">2027</p>
          <p class="cb-where" data-lang-en="Lyon · Sirha" data-lang-fr="Lyon · Sirha">Lyon · Sirha</p>
          <h3 class="cb-phase" data-lang-en="Competition" data-lang-fr="Compétition">Competition</h3>
          <p class="cb-copy" data-lang-en="Team Canada on the floor at Sirha, alongside the Bocuse d'Or. Live coverage, chef-led content and product integration at peak attention." data-lang-fr="Équipe Canada sur le parquet du Sirha, aux côtés du Bocuse d'Or. Couverture en direct, contenu mené par les chefs et intégration de produits au moment de l'attention maximale.">Team Canada on the floor at Sirha, alongside the Bocuse d'Or. Live coverage, chef-led content and product integration at peak attention.</p>
        </li>

        <li class="cb-node">
          <p class="cb-year" data-lang-en="After" data-lang-fr="Après">After</p>
          <p class="cb-where" data-lang-en="Canada" data-lang-fr="Canada">Canada</p>
          <h3 class="cb-phase" data-lang-en="Legacy" data-lang-fr="Héritage">Legacy</h3>
          <p class="cb-copy" data-lang-en="Retrospectives, partner recaps, and the groundwork for an entry that doesn't vanish for another decade." data-lang-fr="Rétrospectives, récapitulatifs pour les partenaires, et les bases d'une présence qui ne s'évanouira pas pour une autre décennie.">Retrospectives, partner recaps, and the groundwork for an entry that doesn't vanish for another decade.</p>
        </li>
      </ol>
    </div>
  </div>
</section>

<hr class="section-divider">

<script is:inline>
  (function () {
    var spine = document.querySelector('.cb-spine');
    if (!spine) return;

    // Without JS or with reduced motion the rail renders lit and static.
    var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced || !('IntersectionObserver' in window)) return;

    spine.classList.add('is-armed');
    var io = new IntersectionObserver(function (entries) {
      for (var i = 0; i < entries.length; i++) {
        if (entries[i].isIntersecting) {
          spine.classList.add('is-lit');
          io.disconnect();
          return;
        }
      }
    }, { threshold: 0.3 });
    io.observe(spine);
  })();
</script>
