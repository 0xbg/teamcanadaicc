---
// ===== SPONSOR HERO: the ask, above the fold =====
// /sponsor is a squeeze page: its one job is to earn the email, because the
// rates now travel as a PDF attachment rather than living on the site. So the
// form sits beside the headline instead of seven screens below it.
//
// The brigade survives as a compact proof row rather than the full-bleed
// triptych — three real faces is what keeps this from being a bare form, but
// the panels can't share one screen with a form card. The full case, with the
// story, the ledger and the budget, moved to /sponsor/dossier.
import InquiryForm from '../InquiryForm.astro';

const brigade = [
  {
    img: '/assets/Bio Photo Chef Donnel.JPG',
    cls: 'sp-face--donnel',
    name: 'Donnel English',
    alt: 'Donnel English, Team Captain and Chef de Cuisine at Bar George',
    roleEn: 'Team Captain',
    roleFr: "Capitaine d'équipe",
  },
  {
    img: '/assets/Bio Photo Chef Nicolas.JPG',
    cls: 'sp-face--nicolas',
    name: 'Nicolas Parsy',
    alt: 'Nicolas Parsy, Pastry Chef, with his 2025 national pastry trophy',
    roleEn: 'Pastry Chef',
    roleFr: 'Chef pâtissier',
  },
  {
    img: '/assets/Bio Photo Chef Kevin.JPG',
    cls: 'sp-face--kevin',
    name: 'Kevin Ramasawmy',
    alt: 'Kevin Ramasawmy, Team Coach and Executive Chef at Bar George',
    roleEn: 'Team Coach',
    roleFr: 'Entraîneur',
  },
];
---

<header class="s2-hero relative bg-ink text-cream overflow-hidden">
  <!-- Same gold dot grid the homepage hero uses -->
  <div class="absolute inset-0 opacity-10 pointer-events-none" aria-hidden="true" style="background-image: radial-gradient(circle at 50% 50%, #c2a15c 1px, transparent 1px); background-size: 40px 40px;"></div>

  <div class="s2-hero-inner relative z-10">
    <div class="s2-hero-copy">
      <p class="text-gold-light font-display italic text-lg mb-5 tracking-wide" data-lang-en="Sponsorship · ICC Lyon 2027" data-lang-fr="Commandite · ICC Lyon 2027">Sponsorship · ICC Lyon 2027</p>
      <h1 class="s2-hero-title font-display font-bold leading-[0.95] mb-6">
        <span class="block" data-lang-en="Canada is" data-lang-fr="Le Canada">Canada is</span>
        <span class="block text-gold" data-lang-en="coming back." data-lang-fr="revient.">coming back.</span>
      </h1>
      <p class="text-text-muted text-lg md:text-xl leading-relaxed mb-6 max-w-xl" data-lang-en="After ten years away, three chefs are rebuilding Canada's seat at the International Catering Cup in Lyon. Eight founding partner slots are open, and all eight are still unclaimed." data-lang-fr="Après dix ans d'absence, trois chefs rebâtissent la place du Canada à l'International Catering Cup à Lyon. Huit places de partenaire fondateur sont ouvertes, et les huit sont encore libres.">After ten years away, three chefs are rebuilding Canada's seat at the International Catering Cup in Lyon. Eight founding partner slots are open, and all eight are still unclaimed.</p>

      <!-- Compact proof: the three faces, small. -->
      <ul class="s2-proof" aria-label="Team Canada's competing chefs">
        {brigade.map((c) => (
          <li class="s2-proof-item">
            <img src={c.img} alt={c.alt} class={`s2-proof-img ${c.cls}`} loading="lazy" />
            <div>
              <p class="s2-proof-name">{c.name}</p>
              <p class="s2-proof-role" data-lang-en={c.roleEn} data-lang-fr={c.roleFr}>{c.roleEn}</p>
            </div>
          </li>
        ))}
      </ul>

      <a href="/sponsor/dossier" class="s2-hero-link" data-lang-en="Read the full case — the story, the tiers, where the money goes →" data-lang-fr="Lire le dossier complet — le récit, les niveaux, l'utilisation des fonds →">Read the full case — the story, the tiers, where the money goes →</a>
    </div>

    <div class="s2-hero-form">
      <InquiryForm />
    </div>
  </div>
</header>
