---
// ===== SPONSOR HERO: photo panel left, the ask right =====
// /sponsor is a lead magnet: its one job is to earn the email, because every
// detail travels in the partnership PDF. So the form sits beside the headline
// rather than below a long case, and there is deliberately no second
// destination anywhere on the page.
//
// The left half is a full-bleed photograph with the copy over it. An earlier
// pass ran the copy on a plain ink field, which left a large dead gap between
// the standfirst and the proof row once the column stretched to match the
// card. The photograph is what fills that height with something worth looking
// at.
import InquiryForm from '../InquiryForm.astro';

const brigade = [
  {
    img: '/assets/Bio Photo Chef Donnel.JPG',
    cls: 'sp-face--donnel',
    name: 'Donnel English',
    alt: 'Donnel English, Team Captain and Chef de Cuisine at Bar George',
    roleEn: 'Team Captain',
    roleFr: "Capitaine d'équipe",
  },
  {
    img: '/assets/Bio Photo Chef Nicolas.JPG',
    cls: 'sp-face--nicolas',
    name: 'Nicolas Parsy',
    alt: 'Nicolas Parsy, Pastry Chef, with his 2025 national pastry trophy',
    roleEn: 'Pastry Chef',
    roleFr: 'Chef pâtissier',
  },
  {
    img: '/assets/Bio Photo Chef Kevin.JPG',
    cls: 'sp-face--kevin',
    name: 'Kevin Ramasawmy',
    alt: 'Kevin Ramasawmy, Team Coach and Executive Chef at Bar George',
    roleEn: 'Team Coach',
    roleFr: 'Entraîneur',
  },
];
---

<header class="s2-hero bg-ink text-cream">
  <div class="s2-hero-inner">
  <div class="s2-hero-panel">
    <img
      src="/assets/hero-chef.jpg"
      alt="Team Canada training in the kitchen at Bar George, Montréal"
      class="s2-hero-panel-img"
      fetchpriority="high"
    />
    <!-- Gold dot grid, the same one the homepage hero carries -->
    <div class="s2-hero-panel-grid" aria-hidden="true"></div>

    <div class="s2-hero-copy">
      <div>
        <p class="text-gold-light font-display italic text-lg mb-5 tracking-wide" data-lang-en="Sponsorship · ICC Lyon 2027" data-lang-fr="Commandite · ICC Lyon 2027">Sponsorship · ICC Lyon 2027</p>
        <h1 class="s2-hero-title font-display font-bold leading-[1.02] mb-6">
          <span data-lang-en="Canada is" data-lang-fr="Le Canada">Canada is</span>{' '}
          <span class="text-gold" data-lang-en="coming back." data-lang-fr="revient.">coming back.</span>
        </h1>
        <p class="s2-hero-standfirst" data-lang-en="After ten years away, three chefs are rebuilding Canada's seat at the International Catering Cup in Lyon. Eight founding partner slots are open, and all eight are still unclaimed." data-lang-fr="Après dix ans d'absence, trois chefs rebâtissent la place du Canada à l'International Catering Cup à Lyon. Huit places de partenaire fondateur sont ouvertes, et les huit sont encore libres.">After ten years away, three chefs are rebuilding Canada's seat at the International Catering Cup in Lyon. Eight founding partner slots are open, and all eight are still unclaimed.</p>
      </div>

      <!-- Anchored to the bottom of the panel, so the copy shares a top and a
           bottom edge with the form card rather than floating mid-column. -->
      <ul class="s2-proof" aria-label="Team Canada's competing chefs">
        {brigade.map((c) => (
          <li class="s2-proof-item">
            <img src={c.img} alt={c.alt} class={`s2-proof-img ${c.cls}`} loading="lazy" />
            <div>
              <p class="s2-proof-name">{c.name}</p>
              <p class="s2-proof-role" data-lang-en={c.roleEn} data-lang-fr={c.roleFr}>{c.roleEn}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="s2-hero-form">
    <InquiryForm />
  </div>
  </div>
</header>
