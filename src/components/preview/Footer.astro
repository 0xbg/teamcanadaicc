---
// ===== FOOTER =====
interface Props {
  ctaHref?: string;
}

const { ctaHref = '#inquiry' } = Astro.props;
---
<footer class="py-20 md:py-28 px-6 bg-ink text-cream text-center">
  <div class="max-w-3xl mx-auto">
    <h2 class="text-3xl md:text-5xl font-bold mb-6 font-display" data-lang-en="Let's Bring Canada Back to the World Stage" data-lang-fr="Ramenez le Canada sur la scène mondiale">Let's Bring Canada Back to the World Stage</h2>
    <p class="text-text-muted text-lg leading-relaxed mb-10 max-w-2xl mx-auto" data-lang-en="Team Canada is going back to Lyon, and we're bringing partners with us. Be part of the comeback." data-lang-fr="Équipe Canada retourne à Lyon, et nous emmenons nos partenaires avec nous. Faites partie du retour.">Team Canada is going back to Lyon, and we're bringing partners with us. Be part of the comeback.</p>
    <a href={ctaHref} class="inline-block bg-gold text-ink px-8 py-4 font-semibold text-lg hover:bg-gold-light transition-colors duration-200 mb-12 rounded-md" data-lang-en="Partner With Team Canada" data-lang-fr="Devenez partenaire d'Équipe Canada">Partner With Team Canada</a>
    <div class="border-t border-border-dark pt-8">
      <p class="text-gold text-lg font-bold mb-1">TEAM CANADA · ICC 2027 · LYON</p>
      <p class="text-text-muted text-xs mt-3"><a href="#" onclick="openPrivacyModal();return false;" class="hover:text-gold underline transition-colors" data-lang-en="Privacy Notice" data-lang-fr="Avis de confidentialité">Privacy Notice</a> · <a href="#" onclick="openTermsModal();return false;" class="hover:text-gold underline transition-colors" data-lang-en="Terms of Service" data-lang-fr="Conditions d'utilisation">Terms of Service</a> · <a href="#" onclick="openAccessibilityModal();return false;" class="hover:text-gold underline transition-colors" data-lang-en="Accessibility" data-lang-fr="Accessibilité">Accessibility</a> · <a href="mailto:privacy@teamcanadaicc.ca" class="hover:text-gold underline transition-colors">privacy@teamcanadaicc.ca</a></p>
      <p class="text-text-muted text-xs mt-4">© 2026 Team Canada ICC. <span data-lang-en="All rights reserved." data-lang-fr="Tous droits réservés.">All rights reserved.</span></p>
      <p class="text-red/70 text-xs mt-2" data-lang-en="Made with ❤️ in Montréal 🍁" data-lang-fr="Fait avec ❤️ à Montréal 🍁">Made with ❤️ in Montréal 🍁</p>
    </div>
  </div>
</footer>