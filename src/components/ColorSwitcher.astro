---
// ============================================================
// ColorSwitcher.astro — Floating palette picker
// Renders 24 palette swatches in a scrollable grid so users
// can preview and swap the entire site color scheme at runtime.
// ============================================================
import palettes from '../palettes';
---

<!-- Floating palette picker -->
<div id="palette-switcher" class="ps-root">
  <button id="ps-toggle" class="ps-toggle" aria-label="Change color palette" title="Change color palette">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"/>
      <path d="M12 2a10 10 0 0 1 0 20"/>
      <path d="M12 2a10 10 0 0 0 0 20"/>
    </svg>
  </button>

  <div id="ps-panel" class="ps-panel">
    <p class="ps-title" data-lang-en="Palettes" data-lang-fr="Palettes">Palettes</p>
    <div class="ps-swatches">
      {palettes.map((p, i) => (
        <button
          class="ps-swatch"
          data-palette={p.id}
          data-index={i}
          title={`${p.label.en} / ${p.label.fr}`}
        >
          <span class="ps-dots" aria-hidden="true">
            <span class="ps-dot" style={`background:${p.colors['--color-gold']}`}></span>
            <span class="ps-dot" style={`background:${p.colors['--color-red']}`}></span>
            <span class="ps-dot" style={`background:${p.colors['--color-cream']}`}></span>
            <span class="ps-dot" style={`background:${p.colors['--color-ink']}`}></span>
          </span>
          <span class="ps-label">
            <span data-lang-en={p.label.en} data-lang-fr={p.label.fr}>{p.label.en}</span>
          </span>
        </button>
      ))}
    </div>
  </div>
</div>

<style>
  .ps-root {
    position: fixed;
    bottom: 2rem;
    left: 2rem;
    z-index: 50;
  }

  .ps-toggle {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--color-ink);
    color: var(--color-gold);
    border: 1.5px solid color-mix(in srgb, var(--color-gold) 35%, transparent);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.25s ease;
    box-shadow: 0 4px 16px rgba(15, 17, 21, 0.25);
    position: relative;
    z-index: 2;
  }

  .ps-toggle:hover {
    background: var(--color-gold);
    color: var(--color-ink);
    border-color: var(--color-gold);
    transform: scale(1.08);
    box-shadow: 0 6px 24px color-mix(in srgb, var(--color-gold) 35%, transparent);
  }

  .ps-panel {
    position: absolute;
    bottom: calc(100% + 0.75rem);
    left: 0;
    background: var(--color-ink);
    border: 1px solid color-mix(in srgb, var(--color-gold) 25%, transparent);
    border-radius: 0.75rem;
    padding: 0.75rem;
    width: 280px;
    max-height: 70vh;
    box-shadow: 0 12px 40px rgba(15, 17, 21, 0.4);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity 0.25s ease, visibility 0.25s ease, transform 0.25s ease;
    pointer-events: none;
    display: flex;
    flex-direction: column;
  }

  .ps-panel.open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  .ps-title {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 0.75rem;
    text-align: center;
  }

  .ps-swatches {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.25rem;
    overflow-y: auto;
    flex: 1;
    padding-right: 0.25rem;

    /* Scrollbar styling within the panel */
    scrollbar-width: thin;
    scrollbar-color: var(--color-gold) transparent;
  }

  .ps-swatch {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.4rem;
    border-radius: 0.375rem;
    border: 1px solid transparent;
    background: transparent;
    cursor: pointer;
    transition: all 0.2s ease;
    width: 100%;
    text-align: left;
    min-width: 0;
  }

  .ps-swatch:hover {
    background: color-mix(in srgb, var(--color-gold) 6%, transparent);
    border-color: color-mix(in srgb, var(--color-gold) 20%, transparent);
  }

  .ps-swatch.active {
    background: color-mix(in srgb, var(--color-gold) 12%, transparent);
    border-color: var(--color-gold);
  }

  .ps-dots {
    display: flex;
    gap: 3px;
    flex-shrink: 0;
  }

  .ps-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.15);
    display: block;
  }

  .ps-label {
    font-family: "Inter", system-ui, sans-serif;
    font-size: 0.68rem;
    font-weight: 500;
    color: var(--color-text-light);
    line-height: 1.15;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ps-swatch.active .ps-label {
    color: var(--color-cream);
    font-weight: 600;
  }

  /* Mobile adjustments */
  @media (max-width: 640px) {
    .ps-root {
      bottom: 1rem;
      left: 1rem;
    }

    .ps-toggle {
      width: 2.5rem;
      height: 2.5rem;
    }

    .ps-toggle svg {
      width: 16px;
      height: 16px;
    }

    .ps-panel {
      width: 260px;
      max-height: 60vh;
      padding: 0.6rem;
    }
  }
</style>

<script>
  import palettes from '../palettes';

  const STORAGE_KEY = 'tc-palette';
  const ACTIVE_CLASS = 'active';
  const OPEN_CLASS = 'open';

  function applyPalette(palette: typeof palettes[0]) {
    const root = document.documentElement;
    for (const [key, value] of Object.entries(palette.colors)) {
      root.style.setProperty(key, value);
    }
    try { localStorage.setItem(STORAGE_KEY, palette.id); } catch (_) { /* noop */ }

    // Update active state in the panel
    document.querySelectorAll('.ps-swatch').forEach((el) => {
      const id = el.getAttribute('data-palette');
      el.classList.toggle(ACTIVE_CLASS, id === palette.id);
    });
  }

  function initSwitcher() {
    const toggle = document.getElementById('ps-toggle');
    const panel = document.getElementById('ps-panel');
    if (!toggle || !panel) return;

    // Toggle panel
    toggle.addEventListener('click', (e) => {
      e.stopPropagation();
      panel.classList.toggle(OPEN_CLASS);
    });

    // Close panel on outside click
    document.addEventListener('click', (e) => {
      const root = document.getElementById('palette-switcher');
      if (root && !root.contains(e.target as Node)) {
        panel.classList.remove(OPEN_CLASS);
      }
    });

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') panel.classList.remove(OPEN_CLASS);
    });

    // Wire up swatch clicks
    document.querySelectorAll('.ps-swatch').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-palette');
        if (!id) return;
        const palette = palettes.find((p) => p.id === id);
        if (palette) {
          applyPalette(palette);
          panel.classList.remove(OPEN_CLASS);
        }
      });
    });

    // Load saved or default
    let savedId: string | null = null;
    try { savedId = localStorage.getItem(STORAGE_KEY); } catch (_) { /* noop */ }
    const activePalette = (savedId && palettes.find((p) => p.id === savedId)) || palettes[0];
    applyPalette(activePalette);
  }

  // Run on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSwitcher);
  } else {
    initSwitcher();
  }
</script>
