<!-- ===== S2 TOP BAR: wordmark + scroll progress + single CTA (no section rail) ===== -->
<div id="s2-topbar" class="fixed top-0 left-0 right-0 z-40 flex items-center justify-between px-5 md:px-8 py-3 md:py-4 bg-ink/80 backdrop-blur-md border-b border-gold/15">
  <span class="font-mono text-[11px] md:text-xs tracking-[0.25em] uppercase text-gold-light">
    <span class="text-gold">Team Canada</span> <span class="hidden sm:inline text-text-muted">— Sponsorship Dossier</span>
  </span>
  <a href="#inquiry" class="inline-block bg-gold text-ink px-4 md:px-5 py-2 font-semibold text-xs md:text-sm tracking-wide hover:bg-gold-light transition-colors duration-200 rounded-full" data-lang-en="Partner With Us" data-lang-fr="Devenez partenaire">Partner With Us</a>
  <span id="s2-progress-bar" class="absolute left-0 -bottom-px h-[2px] bg-gold" style="width:0%"></span>
</div>

<script is:inline>
  (function () {
    var bar = document.getElementById('s2-progress-bar');
    if (!bar) return;
    function update() {
      var h = document.documentElement;
      var scrolled = h.scrollTop;
      var max = h.scrollHeight - h.clientHeight;
      var pct = max > 0 ? (scrolled / max) * 100 : 0;
      bar.style.width = pct + '%';
    }
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  })();
</script>
