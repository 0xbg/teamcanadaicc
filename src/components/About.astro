---
import Icon from './Icon.astro';
---

<!-- ===== THE CUP - ABOUT THE COMPETITION ===== -->
<section id="cup" class="py-20 md:py-28 px-6">
  <div class="max-w-5xl mx-auto">
    <p class="text-gold font-display italic text-lg mb-3" data-lang-en="The Cup" data-lang-fr="La Coupe">The Cup</p>
    <h2 class="text-3xl md:text-4xl font-bold text-ink font-display mb-8" data-lang-en="The International Catering Cup" data-lang-fr="L'International Catering Cup">The International Catering Cup</h2>

    <div class="grid md:grid-cols-2 gap-10 md:gap-12 items-stretch">
      <div>
        <p class="text-body-alt leading-relaxed mb-6" data-lang-en="Held in Lyon during <a href='https://www.sirha.com/' target='_blank' rel='noopener' class='text-gold hover:text-gold-light underline'>Sirha</a>, alongside the <a href='https://www.bocusedor.com/' target='_blank' rel='noopener' class='text-gold hover:text-gold-light underline'>Bocuse d'Or</a>, the <a href='https://www.cateringcup.com/' target='_blank' rel='noopener' class='text-gold hover:text-gold-light underline'>International Catering Cup</a> brings together national teams for one of the hospitality industry's most respected culinary competitions." data-lang-fr="Organisée à Lyon pendant le <a href='https://www.sirha.com/' target='_blank' rel='noopener' class='text-gold hover:text-gold-light underline'>Sirha</a>, aux côtés du <a href='https://www.bocusedor.com/' target='_blank' rel='noopener' class='text-gold hover:text-gold-light underline'>Bocuse d'Or</a>, l'<a href='https://www.cateringcup.com/' target='_blank' rel='noopener' class='text-gold hover:text-gold-light underline'>International Catering Cup</a> rassemble des équipes nationales pour l'une des compétitions culinaires les plus respectées du secteur de l'hôtellerie.">Held in Lyon during <a href="https://www.sirha.com/" target="_blank" rel="noopener" class="text-gold hover:text-gold-light underline">Sirha</a>, alongside the <a href="https://www.bocusedor.com/" target="_blank" rel="noopener" class="text-gold hover:text-gold-light underline">Bocuse d'Or</a>, the <a href="https://www.cateringcup.com/" target="_blank" rel="noopener" class="text-gold hover:text-gold-light underline">International Catering Cup</a> brings together national teams for one of the hospitality industry's most respected culinary competitions.</p>

        <div class="grid grid-cols-2 gap-4">
          <div class="border border-gold/15 bg-cream/95 hover:border-gold/40 transition-colors duration-300 rounded-lg p-5">
            <div class="w-10 h-10 rounded-full border-2 border-gold/40 bg-gold/10 flex items-center justify-center mb-3 text-gold"><Icon name="pin" size={20} /></div>
            <p class="font-mono text-xs uppercase tracking-widest text-gold mb-1" data-lang-en="Host City" data-lang-fr="Ville hôte">Host City</p>
            <p class="text-ink font-semibold text-sm leading-snug" data-lang-en="Lyon, France" data-lang-fr="Lyon, France">Lyon, France</p>
          </div>
          <div class="border border-gold/15 bg-cream/95 hover:border-gold/40 transition-colors duration-300 rounded-lg p-5">
            <div class="w-10 h-10 rounded-full border-2 border-gold/40 bg-gold/10 flex items-center justify-center mb-3 text-gold"><Icon name="calendar" size={20} /></div>
            <p class="font-mono text-xs uppercase tracking-widest text-gold mb-1" data-lang-en="Held Alongside" data-lang-fr="Aux côtés de">Held Alongside</p>
            <p class="text-ink font-semibold text-sm leading-snug" data-lang-en="Sirha · Bocuse d'Or" data-lang-fr="Sirha · Bocuse d'Or">Sirha · Bocuse d'Or</p>
          </div>
          <div class="border border-gold/15 bg-cream/95 hover:border-gold/40 transition-colors duration-300 rounded-lg p-5">
            <div class="w-10 h-10 rounded-full border-2 border-gold/40 bg-gold/10 flex items-center justify-center mb-3 text-gold"><Icon name="toque" size={20} /></div>
            <p class="font-mono text-xs uppercase tracking-widest text-gold mb-1" data-lang-en="Disciplines Judged" data-lang-fr="Disciplines jugées">Disciplines Judged</p>
            <p class="text-ink font-semibold text-sm leading-snug" data-lang-en="Creativity, technical precision, service, pastry & teamwork" data-lang-fr="Créativité, précision technique, service, pâtisserie et travail d'équipe">Creativity, technical precision, service, pastry & teamwork</p>
          </div>
          <div class="border border-gold/15 bg-cream/95 hover:border-gold/40 transition-colors duration-300 rounded-lg p-5">
            <div class="w-10 h-10 rounded-full border-2 border-gold/40 bg-gold/10 flex items-center justify-center mb-3 text-gold"><Icon name="globe" size={20} /></div>
            <p class="font-mono text-xs uppercase tracking-widest text-gold mb-1" data-lang-en="Judged By" data-lang-fr="Jugée par">Judged By</p>
            <p class="text-ink font-semibold text-sm leading-snug" data-lang-en="Leading professionals, media & decision-makers" data-lang-fr="Professionnels de renom, médias et décideurs">Leading professionals, media & decision-makers</p>
          </div>
        </div>
      </div>

      <div class="group order-first md:order-last rounded-md overflow-hidden border border-border-light aspect-[4/3] md:aspect-auto bg-ink">
        <img src="https://placehold.co/800x600/1a1610/c2a15c?text=Sirha+%2F+ICC+Lyon" alt="Placeholder image of the Sirha exhibition floor in Lyon, home of the International Catering Cup" loading="lazy" class="w-full h-full object-cover brightness-90 transition-transform duration-500 group-hover:scale-105 group-hover:brightness-100">
      </div>
    </div>

    <div class="mt-10 bg-olive text-cream rounded-md p-8 md:p-10 flex flex-col md:flex-row md:items-center gap-6 md:gap-8">
      <!-- The leaf and the copy share a row on phones instead of stacking; at
           md the wrapper becomes display:contents so the original
           icon / copy / button row is untouched. -->
      <div class="flex items-center gap-4 md:contents">
      <div class="w-12 h-12 md:w-14 md:h-14 rounded-full border-2 border-gold-light/50 bg-cream/10 flex items-center justify-center shrink-0 text-gold-light"><Icon name="maple" size={26} /></div>
      <div class="flex-1">
        <p class="text-gold-light font-display italic text-lg mb-2" data-lang-en="Representing Canada" data-lang-fr="Représentant le Canada">Representing Canada</p>
        <p class="text-text-light-alt leading-relaxed" data-lang-en="Three chefs from <a href='https://www.bargeorge.ca/' target='_blank' rel='noopener' class='text-gold hover:text-gold-light underline'>Bar George</a> in Montréal make up Team Canada, the country's official entry at the 2027 International Catering Cup." data-lang-fr="Trois chefs du <a href='https://www.bargeorge.ca/' target='_blank' rel='noopener' class='text-gold hover:text-gold-light underline'>Bar George</a> à Montréal forment Équipe Canada, la délégation officielle du pays à l'édition 2027 de l'International Catering Cup.">Three chefs from <a href="https://www.bargeorge.ca/" target="_blank" rel="noopener" class="text-gold hover:text-gold-light underline">Bar George</a> in Montréal make up Team Canada, the country's official entry at the 2027 International Catering Cup.</p>
      </div>
      </div>
      <a href="#team" class="shrink-0 inline-flex items-center gap-2 border border-gold-light text-gold-light hover:bg-gold-light hover:text-ink px-5 py-2.5 btn-cta text-sm font-semibold transition-colors duration-200" data-lang-en="Meet the Team →" data-lang-fr="Voir l'équipe →">Meet the Team →</a>
    </div>
  </div>
</section>

<hr class="section-divider">