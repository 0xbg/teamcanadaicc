---
// ===== LINE ICON SET =====
// Stroke-based icons on a 24x24 grid, inheriting colour from the parent via
// currentColor. Same drawing idiom as the nav icons: round caps and joins.
interface Props {
  name: keyof typeof paths;
  size?: number;
  class?: string;
}

const paths = {
  trophy: `<path d="M7 4h10v5.5a5 5 0 0 1-10 0V4Z"/>
    <path d="M7 6H4.6A1.6 1.6 0 0 0 3 7.6C3 9.8 4.8 11.6 7 11.6"/>
    <path d="M17 6h2.4A1.6 1.6 0 0 1 21 7.6c0 2.2-1.8 4-4 4"/>
    <path d="M12 15v2.5"/>
    <path d="M9.5 20.5h5l-.6-3h-3.8l-.6 3Z"/>`,

  // Eleven points, mirrored about x=12 — every vertex on the left is 24 minus
  // its partner on the right. The previous path was an asymmetric starburst
  // that read as a blob rather than a leaf.
  // The one filled icon in the set, and the one not drawn by hand: this is the
  // maple leaf from the flag of Canada verbatim (public domain), so the
  // proportions are the official ones rather than an approximation. A leaf is
  // a silhouette — as an outline its eleven points collapse into a blob at the
  // 12px and 20px sizes the footer uses.
  //
  // The source artwork lives in viewBox "-1984 -2124 3968 4278". The wrapper
  // below maps that box into this set's 0 0 24 24 grid, centred, with a 0.5
  // unit margin top and bottom: scale = 23/4278, then translate so the leaf
  // spans x 1.33-22.67 and y 0.5-23.5.
  maple: `<g fill="currentColor" stroke="none" transform="translate(12 11.919355) scale(0.00537634)">
    <path d="m-90 2030 45-863a95 95 0 0 0-111-98l-859 151 116-320a65 65 0 0 0-20-73l-941-762 212-99a65 65 0 0 0 34-79l-186-572 542 115a65 65 0 0 0 73-38l105-247 423 454a65 65 0 0 0 111-57l-204-1052 327 189a65 65 0 0 0 91-27l332-652 332 652a65 65 0 0 0 91 27l327-189-204 1052a65 65 0 0 0 111 57l423-454 105 247a65 65 0 0 0 73 38l542-115-186 572a65 65 0 0 0 34 79l212 99-941 762a65 65 0 0 0-20 73l116 320-859-151a95 95 0 0 0-111 98l45 863z"/>
  </g>`,

  megaphone: `<path d="M4 10.5v3a1.5 1.5 0 0 0 1.5 1.5H7l8 4.5V6L7 10.5H5.5A1.5 1.5 0 0 0 4 12Z"/>
    <path d="M7 15v3.5a1.5 1.5 0 0 0 3 0V17"/>
    <path d="M18.5 9.5a4 4 0 0 1 0 5"/>`,

  tag: `<path d="m20.6 12.6-8 8a2 2 0 0 1-2.8 0l-6.4-6.4A2 2 0 0 1 3 12.8V5a2 2 0 0 1 2-2h7.8a2 2 0 0 1 1.4.6l6.4 6.4a2 2 0 0 1 0 2.8Z"/>
    <circle cx="7.6" cy="7.6" r="1.3"/>`,

  jacket: `<path d="M9 3 12 6l3-3 4.4 1.8a1.8 1.8 0 0 1 1.1 1.9l-.5 3.2h-2.6v10.9H6.6V9.9H4l-.5-3.2A1.8 1.8 0 0 1 4.6 4.8L9 3Z"/>
    <path d="M12 6v14.8"/>
    <circle cx="14.7" cy="11.4" r=".85"/>
    <circle cx="14.7" cy="15.4" r=".85"/>`,

  flame: `<path d="M12 2.6c-.4 2.6-1.8 3.9-3.2 5.5C7.4 9.6 6.6 11.1 6.6 13a5.4 5.4 0 0 0 10.8 0c0-2-.9-3.5-2.1-4.9-.4.9-1 1.6-1.8 1.9.6-2.7 0-5.2-1.5-7.4Z"/>`,

  pin: `<path d="M12 21.2s6.6-6 6.6-10.8a6.6 6.6 0 0 0-13.2 0C5.4 15.2 12 21.2 12 21.2Z"/>
    <circle cx="12" cy="10.3" r="2.5"/>`,

  calendar: `<rect x="3.2" y="5.2" width="17.6" height="15.6" rx="2.2"/>
    <path d="M3.2 10.2h17.6"/>
    <path d="M8.2 3.2v3.6M15.8 3.2v3.6"/>`,

  toque: `<path d="M6.6 13.6a3.8 3.8 0 1 1 1.9-7.1 3.8 3.8 0 0 1 7 0 3.8 3.8 0 1 1 1.9 7.1v2.1H6.6v-2.1Z"/>
    <path d="M6.6 15.7h10.8v3.4a1.4 1.4 0 0 1-1.4 1.4H8a1.4 1.4 0 0 1-1.4-1.4v-3.4Z"/>`,

  globe: `<circle cx="12" cy="12" r="9"/>
    <path d="M3 12h18"/>
    <path d="M12 3a13.5 13.5 0 0 1 0 18 13.5 13.5 0 0 1 0-18Z"/>`,

  check: `<path d="m4.8 12.6 4.8 4.8L19.2 6.6"/>`,

  star: `<path d="m12 3.3 2.7 5.5 6 .9-4.3 4.2 1 6-5.4-2.8-5.4 2.8 1-6-4.3-4.2 6-.9L12 3.3Z"/>`,

  pan: `<path d="M3.4 10.8h12.2v1.9a6.1 6.1 0 0 1-12.2 0v-1.9Z"/>
    <path d="m15.6 11.6 5.2-2.4"/>
    <circle cx="9.5" cy="14.4" r="1.9"/>`,

  plane: `<path d="M21 15.4 13.4 11V5.1a1.7 1.7 0 0 0-3.4 0V11L2.4 15.4v2.2l7.6-2.2v3.5l-2.2 1.5v1.4l3.9-1 3.9 1v-1.4l-2.2-1.5v-3.5l7.6 2.2v-2.2Z"/>`,

  heart: `<path d="M12 20.6s-7.6-4.8-7.6-10a4.4 4.4 0 0 1 7.6-2.9 4.4 4.4 0 0 1 7.6 2.9c0 5.2-7.6 10-7.6 10Z"/>`,
} as const;

const { name, size = 22, class: className = '' } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>
