---
// ===== PARTNERSHIP INQUIRY FORM =====
// A compact card, built to sit in the sponsor hero's right column rather than
// as its own band — /sponsor is a squeeze page now and the form is the CTA.
//
// The element IDs below (inquiry-form, name, email, form-status, and the submit
// button) are bound by ID in Layout.astro's inline script. Renaming any of them
// silently breaks submission.
//
// The consent checkbox and the closing privacy paragraph are compliance, not
// decoration; they move wherever the form moves.
//
// Tier is a select rather than chips: eight chips wrapped to three rows and
// forced the whole card wider than the hero column wanted to be. A select is
// one row at any width, which is what lets this stay a narrow column.
const tiers = [
  { value: 'Lead Partner', en: 'Lead Partner', fr: 'Partenaire majeur' },
  { value: 'Premier Partner', en: 'Premier Partner', fr: 'Partenaire Premier' },
  { value: 'Official Partner', en: 'Official Partner', fr: 'Partenaire Officiel' },
  { value: 'Supporting Partner', en: 'Supporting Partner', fr: 'Partenaire de soutien' },
  { value: 'Team Contributor', en: 'Team Contributor', fr: "Contributeur d'équipe" },
  { value: 'Team Supporter', en: 'Team Supporter', fr: "Supporteur de l'équipe" },
  { value: 'In-Kind Partnership', en: 'In-kind partnership', fr: 'Partenariat en nature' },
  { value: 'Not sure yet', en: 'Not sure yet', fr: 'Pas encore certain' },
];
---

<div id="inquiry" class="s2-form-card">
  <p class="s2-form-eyebrow" data-lang-en="Free · No obligation" data-lang-fr="Gratuit · Sans engagement">Free · No obligation</p>
  <h2 class="s2-form-title" data-lang-en="Get the partnership package" data-lang-fr="Recevez le dossier de partenariat">Get the partnership package</h2>
  <p class="s2-form-sub" data-lang-en="Tiers, benefits and rates. Download the PDF the moment you submit, and a copy lands in your inbox." data-lang-fr="Niveaux, avantages et tarifs. Téléchargez le PDF dès l'envoi, et une copie arrive dans votre boîte de réception.">Tiers, benefits and rates. Download the PDF the moment you submit, and a copy lands in your inbox.</p>

  <form id="inquiry-form" class="s2-form">
    <div class="s2-form-row">
      <div>
        <label for="name" class="s2-form-label"><span data-lang-en="Full name" data-lang-fr="Nom complet">Full name</span> *</label>
        <input type="text" id="name" name="name" required class="form-input s2-form-input" data-lang-en-placeholder="Your full name" data-lang-fr-placeholder="Votre nom complet" placeholder="Your full name">
      </div>
      <div>
        <label for="email" class="s2-form-label"><span data-lang-en="Email" data-lang-fr="Courriel">Email</span> *</label>
        <input type="email" id="email" name="email" required class="form-input s2-form-input" placeholder="you@example.com">
      </div>
    </div>

    <div>
      <label for="company" class="s2-form-label" data-lang-en="Company / organization" data-lang-fr="Entreprise / organisation">Company / organization</label>
      <input type="text" id="company" name="company" class="form-input s2-form-input" data-lang-en-placeholder="Your company" data-lang-fr-placeholder="Votre entreprise" placeholder="Your company">
    </div>

    <div>
      <label for="tier" class="s2-form-label" data-lang-en="Tier of interest (optional)" data-lang-fr="Niveau souhaité (optionnel)">Tier of interest (optional)</label>
      <select id="tier" name="tier" class="form-input s2-form-input s2-form-select">
        <option value="" data-lang-en="Select a tier" data-lang-fr="Choisir un niveau">Select a tier</option>
        {
          tiers.map((t) => (
            <option value={t.value} data-lang-en={t.en} data-lang-fr={t.fr}>{t.en}</option>
          ))
        }
      </select>
    </div>

    <label class="s2-form-consent">
      <input type="checkbox" name="privacy_consent" required class="mt-0.5 w-4 h-4 accent-gold flex-shrink-0">
      <span data-lang-en="I consent to Team Canada ICC using my name, email and company to answer this enquiry and send partnership communications. I can withdraw at any time via <a href='mailto:privacy@teamcanadaicc.ca'>privacy@teamcanadaicc.ca</a>." data-lang-fr={`Je consens à ce qu'Équipe Canada ICC utilise mon nom, mon courriel et mon entreprise pour répondre à cette demande et m'envoyer des communications liées au partenariat. Je peux retirer mon consentement en tout temps à <a href='mailto:privacy@teamcanadaicc.ca'>privacy@teamcanadaicc.ca</a>.`}>
        I consent to Team Canada ICC using my name, email and company to answer this enquiry and send partnership communications. I can withdraw at any time via <a href="mailto:privacy@teamcanadaicc.ca">privacy@teamcanadaicc.ca</a>.
      </span>
    </label>

    <div class="cf-turnstile" data-sitekey="0x4AAAAAAD7dywzp4fMuCq9h" data-action="turnstile-spin-v2" data-size="flexible"></div>
    <div id="form-status" class="hidden text-sm font-semibold p-3 rounded-md" role="status" aria-live="polite"></div>

    <button type="submit" class="s2-form-submit btn-cta" data-lang-en="Send me the package" data-lang-fr="Envoyez-moi le dossier">Send me the package</button>
    <ul class="s2-form-next">
      <li data-lang-en="No obligation, no mailing list, and your details are never shared." data-lang-fr="Aucun engagement, aucune infolettre, et vos coordonnées ne sont jamais partagées.">No obligation, no mailing list, and your details are never shared.</li>
    </ul>
    <p class="s2-form-legal" data-lang-en="Your data is stored securely and is never sold, rented or shared. See our <a href='/privacy'>Privacy Notice</a>." data-lang-fr={`Vos données sont conservées de façon sécurisée et ne sont jamais vendues, louées ni partagées. Consultez notre <a href='/privacy'>Avis de confidentialité</a>.`}>
      Your data is stored securely and is never sold, rented or shared. See our <a href="/privacy">Privacy Notice</a>.
    </p>
  </form>
</div>
