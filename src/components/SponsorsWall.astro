<!-- ===== SPONSORS WALL ===== -->
<section id="sponsors" class="py-20 md:py-28 px-6 bg-ink text-cream">
  <div class="max-w-6xl mx-auto">
    <p class="text-gold font-display italic text-lg mb-3 text-center" data-lang-en="Our Partners" data-lang-fr="Nos partenaires">Our Partners</p>
    <h2 class="text-3xl md:text-5xl font-bold mb-6 font-display text-center" data-lang-en="Sponsors Wall" data-lang-fr="Mur des commanditaires">Sponsors Wall</h2>
    <p class="text-text-muted text-lg leading-relaxed max-w-3xl mx-auto mb-10 text-center" data-lang-en="The organizations, brands and individuals who are helping bring Team Canada back to the world stage." data-lang-fr="Les organisations, marques et individus qui aident à ramener Équipe Canada sur la scène mondiale.">The organizations, brands and individuals who are helping bring Team Canada back to the world stage.</p>

    <!-- FILTER BAR -->
    <div class="flex flex-wrap justify-center gap-2 md:gap-3 mb-14" role="tablist" aria-label="Sponsor filter">
      <button class="filter-pill active" role="tab" aria-selected="true" data-filter="all">
        <span data-lang-en="All" data-lang-fr="Tous">All</span>
      </button>
      <button class="filter-pill" role="tab" aria-selected="false" data-filter="lead">
        <span data-lang-en="Lead" data-lang-fr="Majeur">Lead</span>
      </button>
      <button class="filter-pill" role="tab" aria-selected="false" data-filter="premier">
        <span data-lang-en="Premier" data-lang-fr="Premier">Premier</span>
      </button>
      <button class="filter-pill" role="tab" aria-selected="false" data-filter="official">
        <span data-lang-en="Official" data-lang-fr="Officiel">Official</span>
      </button>
      <button class="filter-pill" role="tab" aria-selected="false" data-filter="supporting">
        <span data-lang-en="Supporting" data-lang-fr="Soutien">Supporting</span>
      </button>
      <button class="filter-pill" role="tab" aria-selected="false" data-filter="community">
        <span data-lang-en="In-Kind" data-lang-fr="Fournisseurs">In-Kind</span>
      </button>
    </div>

    <!-- SPONSOR GRID -->
    <div id="sponsor-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 md:gap-6">
      <!-- Populated by JavaScript -->
    </div>

    <!-- Bottom CTA -->
    <div class="text-center mt-14 pt-8 border-t border-border-dark">
      <p class="text-text-muted text-sm mb-6 max-w-xl mx-auto" data-lang-en="Want to see your logo here? Join the team and help us make history in Lyon." data-lang-fr="Vous voulez voir votre logo ici ? Rejoignez l'équipe et aidez-nous à marquer l'histoire à Lyon.">Want to see your logo here? Join the team and help us make history in Lyon.</p>
      <a href="#inquiry" class="inline-block bg-red hover:bg-red-dark text-white px-8 py-3 font-semibold text-sm transition-colors duration-200 rounded-md" data-lang-en="Become a Sponsor" data-lang-fr="Devenez commanditaire">Become a Sponsor</a>
    </div>
  </div>
</section>