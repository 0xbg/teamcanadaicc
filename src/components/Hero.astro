---
import { Image } from 'astro:assets';
import heroChef from '../assets/hero-chef.jpg';
---

<!-- ===== HERO ===== -->
<header class="hero-viewport relative flex flex-col items-center justify-center text-center px-6 py-20 bg-ink text-cream pt-16 md:pt-20">
  <Image src={heroChef} alt="Chef Kevin Ramasawmy in the kitchen, on Team Canada's road to ICC Lyon 2027" class="absolute inset-0 w-full h-full object-cover opacity-25" width={1920} widths={[768, 1280, 1920]} sizes="100vw" format="webp" quality={70} loading="eager" fetchpriority="high" />
  <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/55 to-ink/25"></div>
  <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 50% 50%, #c2a15c 1px, transparent 1px); background-size: 40px 40px;"></div>
  <div class="relative z-10 max-w-3xl">
    <p class="text-gold-light font-display italic text-lg md:text-xl mb-4 tracking-wide" data-lang-en="Ten Years Away. One Stage to Reclaim." data-lang-fr="Dix ans d'absence. Une scène à reconquérir.">Ten Years Away. One Stage to Reclaim.</p>
    <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold tracking-tight leading-tight mb-6 font-display">TEAM CANADA</h1>
    <p class="text-gold text-xl md:text-2xl font-display tracking-widest uppercase mb-8">ICC · LYON 2027</p>
    <p class="text-text-muted text-lg md:text-xl max-w-2xl mx-auto mb-10 leading-relaxed" data-lang-en="Canada returns to the International Catering Cup in Lyon.<br>Now, the comeback begins." data-lang-fr="Le Canada revient à l'International Catering Cup à Lyon.<br>Le retour commence maintenant.">Canada returns to the International Catering Cup in Lyon.<br>Now, the comeback begins.</p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href="/sponsor" class="inline-block bg-gold text-ink px-8 py-4 font-semibold text-lg hover:bg-gold-light transition-colors duration-200 btn-cta" data-lang-en="Become a Partner" data-lang-fr="Devenez partenaire">Become a Partner</a>
      <a href="#opportunity" class="inline-block border border-gold text-gold px-8 py-4 font-semibold text-lg hover:bg-gold hover:text-ink transition-colors duration-200 btn-cta" data-lang-en="Why Sponsor Us" data-lang-fr="Pourquoi nous commanditer">Why Sponsor Us</a>
    </div>
    <p class="text-text-muted text-xs mt-4" data-lang-en="Eight founding slots · No obligation to enquire" data-lang-fr="Huit places fondatrices · Aucun engagement pour s'informer">Eight founding slots · No obligation to enquire</p>
    <div class="grid grid-cols-3 gap-x-3 sm:gap-x-8 gap-y-4 mt-12">
      <div>
        <p class="font-mono text-2xl md:text-3xl font-bold text-gold">3</p>
        <p class="text-text-muted text-xs md:text-sm tracking-wide" data-lang-en="world-class chefs" data-lang-fr="chefs de renommée mondiale">world-class chefs</p>
      </div>
      <div>
        <p class="font-mono text-2xl md:text-3xl font-bold text-gold">2027</p>
        <p class="text-text-muted text-xs md:text-sm tracking-wide" data-lang-en="Lyon · Sirha · ICC" data-lang-fr="Lyon · Sirha · ICC">Lyon · Sirha · ICC</p>
      </div>
      <div>
        <p class="font-mono text-2xl md:text-3xl font-bold text-gold">8</p>
        <p class="text-text-muted text-xs md:text-sm tracking-wide" data-lang-en="flagship partner slots" data-lang-fr="places partenaires phares">flagship partner slots</p>
      </div>
    </div>
  </div>
  <a href="#cup" class="scroll-cue absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-3 group cursor-pointer" aria-label="Scroll to next section">
    <span class="text-gold-light/60 group-hover:text-gold-light text-[10px] tracking-[0.3em] uppercase font-mono transition-colors duration-300" data-lang-en="Scroll" data-lang-fr="Défiler">Scroll</span>
    <span class="scroll-cue-steam" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </span>
  </a>
</header>