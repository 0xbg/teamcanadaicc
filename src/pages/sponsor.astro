---
// A lead-magnet squeeze page: hero with the form in it, the objections
// answered, footer. The magnet is the partnership PDF, which is why there is
// no long-form case anywhere on the site — every detail travels in the
// attachment, and a second page would only compete with the form.
//
// The nav is mobileOnly: a section rail beside two sections would be noise on
// desktop, but the menu belongs on phones here as on every other page.
import Layout from '../layouts/Layout.astro';
import VerticalNav from '../components/VerticalNav.astro';
import Hero from '../components/sponsor/Hero.astro';
import Faq from '../components/sponsor/Faq.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
---

<Layout
  ctaHref="#inquiry"
  stickyCta={false}
  title="Partner With Team Canada · ICC · Lyon 2027"
  titleEn="Partner With Team Canada · ICC · Lyon 2027"
  titleFr="Devenez partenaire d'Équipe Canada · ICC · Lyon 2027"
  descriptionEn="Eight founding partner slots are open for Canada's return to the International Catering Cup in Lyon. Tell us which tier interests you and we'll email the partnership package as a PDF."
  descriptionFr="Huit places de partenaire fondateur sont ouvertes pour le retour du Canada à l'International Catering Cup à Lyon. Dites-nous quel niveau vous intéresse et nous vous enverrons le dossier de partenariat en PDF."
>
  <VerticalNav
    mobileOnly
    links={[
      { href: '#inquiry', en: 'Get the package', fr: 'Recevoir le dossier' },
      { href: '#faq', en: 'FAQ', fr: 'FAQ' },
      { href: '/', en: 'Home', fr: 'Accueil' },
      { href: '/en/blog', en: 'Blog', fr: 'Blogue' },
    ]}
  />
  <Hero />
  <Faq />
  <Footer ctaHref="#inquiry" />
  <CookieBanner />
</Layout>
