---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/sponsor/TopBar.astro';
import Hero from '../components/sponsor/Hero.astro';
import Story from '../components/sponsor/Story.astro';
import Ledger from '../components/sponsor/Ledger.astro';
import Terms from '../components/sponsor/Terms.astro';
import InquiryForm from '../components/InquiryForm.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
---

<Layout
  title="Sponsorship Dossier · Team Canada · ICC · Lyon 2027"
  titleEn="Sponsorship Dossier · Team Canada · ICC · Lyon 2027"
  titleFr="Dossier de commandite · Équipe Canada · ICC · Lyon 2027"
  descriptionEn="The case for backing Team Canada's return to the International Catering Cup in Lyon: the story, the investment, and the terms."
  descriptionFr="Le dossier pour soutenir le retour d'Équipe Canada à l'International Catering Cup à Lyon : l'histoire, l'investissement et les modalités."
>
  <!-- Language rail (same fixed left pill used site-wide) -->
  <div class="lang-rail" role="group" aria-label="Language">
    <span class="lang-thumb" aria-hidden="true"></span>
    <button id="lang-en" class="lang-btn active" data-lang="en" aria-pressed="true" title="English" onclick="setLang('en')">EN</button>
    <span class="lang-rail-sep" aria-hidden="true"></span>
    <button id="lang-fr" class="lang-btn" data-lang="fr" aria-pressed="false" title="Français" onclick="setLang('fr')">FR</button>
  </div>

  <TopBar />
  <Hero />
  <Story />
  <Ledger />
  <Terms />
  <InquiryForm />
  <Footer ctaHref="#inquiry" />
  <CookieBanner />
</Layout>
