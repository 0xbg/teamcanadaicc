---
import Layout from '../layouts/Layout.astro';
import VerticalNav from '../components/VerticalNav.astro';
import ReadingProgress from '../components/sponsor/ReadingProgress.astro';
import Hero from '../components/sponsor/Hero.astro';
import Story from '../components/sponsor/Story.astro';
import Ledger from '../components/sponsor/Ledger.astro';
import Terms from '../components/sponsor/Terms.astro';
import InquiryForm from '../components/InquiryForm.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
---

<Layout
  title="Sponsorship Dossier · Team Canada · ICC · Lyon 2027"
  titleEn="Sponsorship Dossier · Team Canada · ICC · Lyon 2027"
  titleFr="Dossier de commandite · Équipe Canada · ICC · Lyon 2027"
  descriptionEn="The case for backing Team Canada's return to the International Catering Cup in Lyon: the story, the investment, and the terms."
  descriptionFr="Le dossier pour soutenir le retour d'Équipe Canada à l'International Catering Cup à Lyon : l'histoire, l'investissement et les modalités."
>
  <!-- Same nav shell as the homepage: right rail on desktop, hamburger and
       full-screen drawer below 1024px. The drawer is what carries the EN/FR
       pills on mobile, so the page needs it to stay bilingual on phones. -->
  <VerticalNav
    links={[
      { href: '#story', en: 'Story', fr: 'Le récit' },
      { href: '#ledger', en: 'Investment', fr: 'Investissement' },
      { href: '#terms', en: 'Terms', fr: 'Modalités' },
      { href: '#inquiry', en: 'Partner', fr: 'Partenaire' },
      { href: '/', en: 'Home', fr: 'Accueil' },
    ]}
  />
  <ReadingProgress />
  <Hero />
  <Story />
  <Ledger />
  <Terms />
  <InquiryForm />
  <Footer ctaHref="#inquiry" />
  <CookieBanner />
</Layout>
