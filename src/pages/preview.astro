---
// ============================================================
// STAGED HOME PAGE REVAMP - REVIEW COPY
// Order mandated: Hero → The Cup → The Comeback → Team →
// Sponsor marquee → Sponsor CTA. The full sales stack lives on
// the dedicated sponsor page (src/pages/preview-sponsor.astro).
// The live homepage (src/pages/index.astro) is untouched until
// this page is reviewed and approved.
// ============================================================
import PreviewLayout from '../layouts/PreviewLayout.astro';
import VerticalNav from '../components/preview/VerticalNav.astro';
import Hero from '../components/preview/Hero.astro';
import About from '../components/preview/About.astro';
import Timeline from '../components/preview/Timeline.astro';
import Team from '../components/preview/Team.astro';
import SponsorMarquee from '../components/preview/SponsorMarquee.astro';
import SponsorCTA from '../components/preview/SponsorCTA.astro';
import Footer from '../components/preview/Footer.astro';
// Shared, unchanged components (recent WIP kept as-is):
import PrivacyModal from '../components/PrivacyModal.astro';
import TermsModal from '../components/TermsModal.astro';
import AccessibilityModal from '../components/AccessibilityModal.astro';
import CookieBanner from '../components/CookieBanner.astro';
---

<PreviewLayout>
  <VerticalNav
    links={[
      { href: '#cup', en: 'The Cup', fr: 'La Coupe' },
      { href: '#comeback', en: 'The Comeback', fr: 'Le retour' },
      { href: '#team', en: 'Team', fr: 'Équipe' },
      { href: '/preview-sponsor', en: 'Sponsor', fr: 'Commanditer' },
      { href: '/en/blog', en: 'Blog', fr: 'Blogue' },
    ]}
  />
  <Hero />
  <About />
  <Timeline />
  <Team />
  <SponsorMarquee />
  <SponsorCTA />
  <Footer ctaHref="/preview-sponsor" />
  <PrivacyModal />
  <TermsModal />
  <AccessibilityModal />
  <CookieBanner />
</PreviewLayout>
