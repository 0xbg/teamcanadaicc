---
import Layout from '../layouts/Layout.astro';
import VerticalNav from '../components/VerticalNav.astro';
import Hero from '../components/Hero.astro';
import Opportunity from '../components/Opportunity.astro';
import About from '../components/About.astro';
import Timeline from '../components/Timeline.astro';
import Team from '../components/Team.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
---

<Layout>
  <VerticalNav
    links={[
      { href: '#cup', en: 'The Cup', fr: 'La Coupe' },
      { href: '#team', en: 'Team', fr: 'Équipe' },
      { href: '#comeback', en: 'The Comeback', fr: 'Le retour' },
      { href: '/sponsor', en: 'Sponsor', fr: 'Commanditer' },
      { href: '/en/blog', en: 'Blog', fr: 'Blogue' },
    ]}
  />
  <Hero />
  <About />
  <Team />
  <Timeline />
  <Opportunity />
  <Footer ctaHref="/sponsor" />
  <CookieBanner />
</Layout>
