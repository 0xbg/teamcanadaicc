# === MCP Server Environment Variables ===

# Cloudflare MCP (@cloudflare/mcp-server-cloudflare)
# Get your API token from: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token-here
# Find your Account ID at: https://dash.cloudflare.com → pick an account → overview
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id-here

# GitHub MCP (@modelcontextprotocol/server-github)
# Create a Personal Access Token at: https://github.com/settings/tokens
# Required scopes: repo, workflow, read:org, read:user
GITHUB_PERSONAL_ACCESS_TOKEN=your-github-personal-access-token-here

# === Team Canada ICC App ===

# Web3Forms API Key
# Get your free API key at: https://web3forms.com/#start
WEB3FORMS_API_KEY=your-web3forms-api-key-here

# Cloudflare Turnstile Secret
# Created via `npx wrangler turnstile widget create` or from the Cloudflare dashboard
# For local development only; on Pages, use `wrangler pages secret put TURNSTILE_SECRET`
TURNSTILE_SECRET=your-turnstile-secret-here
